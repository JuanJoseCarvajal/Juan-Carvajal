---
import { copy, type Locale } from '../data/i18n';
const { lang = 'es', title, description, alternate } = Astro.props as {lang:Locale; title?:string; description?:string; alternate:string};
const t = copy[lang];
const home = lang === 'es' ? '/' : '/en/';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || t.description} />
    <meta name="theme-color" content="#f5f5f0" />
    <meta property="og:title" content={title || t.title} />
    <meta property="og:description" content={description || t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <title>{title || t.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alternate} />
    <link rel="stylesheet" href="/theme.css" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label={lang === 'es' ? 'Juan Carvajal — Inicio' : 'Juan Carvajal — Home'}>juan carvajal<span class="brand-dot">*</span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label={t.menu}>{lang === 'es' ? 'Menú' : 'Menu'} <span>+</span></button>
      <nav id="navigation" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
        {['work','services','about'].map((id,i) => <a href={`${home}#${id}`}>{t.nav[i]}</a>)}
        <a class="nav-contact" href={`${home}#contact`}>{t.contact}<span class="small-cross" aria-hidden="true">+</span></a>
      </nav>
      <div class="header-tools">
        <a class="language" href={alternate} lang={lang === 'es' ? 'en' : 'es'} aria-label={lang === 'es' ? 'Switch to English' : 'Cambiar a español'}><span class:list={{selected:lang==='es'}}>ES</span><span class="slash">/</span><span class:list={{selected:lang==='en'}}>EN</span></a>
        <button class="theme-switcher" id="theme-switcher" aria-label={t.theme} title={t.theme}>◐</button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><a class="brand" href={home}>juan carvajal<span class="brand-dot">*</span></a><p>{t.footer}</p><span>© {new Date().getFullYear()}</span></footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector('#navigation');
      const closeMenu = () => { menu?.setAttribute('aria-expanded','false'); nav?.classList.remove('open'); };
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded',String(open)); nav?.classList.toggle('open',open); });
      nav?.querySelectorAll('a').forEach(a => a.addEventListener('click',closeMenu));
      document.addEventListener('keydown',e => {if(e.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true'){closeMenu(); menu?.focus();}});
      document.querySelector('.language')?.addEventListener('click',function(){ if(location.hash) this.setAttribute('href',this.getAttribute('href')!.split('#')[0]+location.hash); });
      window.initializeThemeSwitcher('theme-switcher');
    </script>
  </body>
</html>
