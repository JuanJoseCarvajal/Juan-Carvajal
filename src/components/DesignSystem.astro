---
import Layout from '../layouts/Layout.astro';
const {lang='es'}=Astro.props;const es=lang==='es';
const colors=[['Signal orange','--brand-orange','#F93202'],['Electric violet','--brand-violet','#7C40FF'],['Carbon','--brand-ink','#161616'],['White','--brand-white','#FFFFFF']];
---
<Layout lang={lang} title="Juan Carvajal — Design system" alternate={es?'/en/design-system/':'/design-system/'}>
 <div class="ds-page wrap">
  <span class="eyebrow">JUAN CARVAJAL / DESIGN LANGUAGE / 01</span>
  <h1>{es?'Un lenguaje.\nCada experiencia.':'One language.\nEvery experience.'}</h1>
  <p class="ds-intro">{es?'La identidad del portafolio, convertida en un sistema: color, tipografía, componentes y movimiento.':'The portfolio identity, made into a system: color, typography, components and motion.'}</p>
  <section><div class="ds-heading"><span>01 / {es?'COLOR':'COLOR'}</span><h2>{es?'La marca, sin perder su esencia.':'The brand, true to its essence.'}</h2></div><div class="ds-colors">{colors.map(([name,token,value])=><article><div class="ds-swatch" style={`--swatch:${value}`} aria-hidden="true"></div><h3>{name}</h3><p>{value}</p><code>{token}</code></article>)}</div><p class="ds-caption">{es?'Naranja para acción y expresión. Violeta para foco y profundidad. Carbón y blanco para lectura. Los enlaces pequeños usan #B72400 sobre blanco para mejorar el contraste.':'Orange for action and expression. Violet for focus and depth. Carbon and white for reading. Small links use #B72400 on white for stronger contrast.'}</p></section>
  <section><div class="ds-heading"><span>02 / {es?'TIPOGRAFÍA':'TYPE'}</span><h2>{es?'Clara. Directa. Con carácter.':'Clear. Direct. With character.'}</h2></div><div class="ds-type"><div><span class="eyebrow">MANROPE / DISPLAY</span><h2>Aa — 0123</h2><p>{es?'Titulares expresivos, interlineado compacto y escala fluida.':'Expressive headings, tight line height and a fluid scale.'}</p></div><div><span class="eyebrow">DM SANS / BODY</span><p class="ds-type-body">{es?'El buen diseño respeta el tiempo y la atención de las personas.':'Good design respects people’s time and attention.'}</p><p>16px / 1.6</p></div></div></section>
  <section><div class="ds-heading"><span>03 / {es?'COMPONENTES':'COMPONENTS'}</span><h2>{es?'Una acción, una intención.':'Every action has a purpose.'}</h2></div><div class="ds-demo"><a class="button primary" href={es?'/#contact':'/en/#contact'}>{es?'Iniciar una conversación':'Start a conversation'} ↗</a><a class="text-link" href={es?'/#work':'/en/#work'}>{es?'Explorar proyectos':'Explore projects'} ↓</a><button class="button" id="demo-toggle" aria-pressed="false" type="button">{es?'Alternar selección':'Toggle selection'}</button></div><p class="ds-caption">{es?'Prueba hover, foco con Tab y selección. Los controles de la escena tienen un área táctil mínima de 44 px.':'Try hover, Tab focus and selection. Scene controls have a minimum 44 px touch target.'}</p><div class="ds-demo"><label>{es?'Campo de formulario':'Form field'}<input placeholder={es?'Tu nombre':'Your name'} autocomplete="off"/></label><details><summary>{es?'Detalle desplegable':'Expandable detail'}</summary><p>{es?'Un control nativo que funciona con teclado y sin JavaScript.':'A native control that works with a keyboard and without JavaScript.'}</p></details></div></section>
  <section><div class="ds-heading"><span>04 / {es?'ESPACIO Y FORMA':'SPACE AND SHAPE'}</span><h2>{es?'Ritmo consistente.':'Consistent rhythm.'}</h2></div><div class="ds-space">{[4,8,12,16,24,32,48,64,96].map(n=><div><span style={`width:${n}px`}></span><code>{n}px</code></div>)}</div><div class="ds-radii">{[['sm','8'],['md','16'],['lg','24']].map(([name,n])=><div style={`border-radius:var(--radius-${name})`}>{n}px</div>)}</div></section>
  <section><div class="ds-heading"><span>05 / {es?'MOVIMIENTO':'MOTION'}</span><h2>{es?'El movimiento tiene sentido.':'Motion with meaning.'}</h2></div><div class="ds-type"><div><h3>160 / 300 / 700 ms</h3><p>{es?'Respuesta inmediata, transición de componente y cambio de escena.':'Immediate feedback, component transitions and scene changes.'}</p></div><div><h3>{es?'Tú tienes el control.':'You are in control.'}</h3><p>{es?'Arrastre, flechas y restablecer en la portada. En móvil, capítulos por botón. Con movimiento reducido, sin scroll vinculado ni animaciones.':'Drag, arrow keys and reset on the homepage. Button chapters on mobile. Reduced motion disables scroll-linked scenes and animations.'}</p><a class="text-link" href={es?'/':'/en/'}>{es?'Probar la escena':'Try the scene'} ↗</a></div></div></section>
 </div>
</Layout>
<script>
const toggle=document.querySelector('#demo-toggle');toggle?.addEventListener('click',()=>toggle.setAttribute('aria-pressed',String(toggle.getAttribute('aria-pressed')!=='true')));
</script>
<style>
.ds-page{padding-block:72px}.ds-page h1{font-size:clamp(3rem,6vw,6rem);letter-spacing:-.065em;line-height:1.05;white-space:pre-line;margin:28px 0}.ds-intro{max-width:650px;font-size:1.2rem}.ds-page section{border-top:1px solid var(--border);padding-top:40px;margin-top:80px}.ds-heading{display:grid;grid-template-columns:1fr 2fr;gap:32px;margin-bottom:40px}.ds-heading>span{font-size:.65rem;letter-spacing:.1em}.ds-heading h2{font-size:2rem}.ds-colors{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.ds-swatch{height:150px;background:var(--swatch);border:1px solid var(--border);border-radius:var(--radius-md);margin-bottom:16px}.ds-colors h3{font-size:1.1rem}code{font-size:.75rem;color:var(--muted)}.ds-caption{font-size:.875rem;margin-top:24px;max-width:800px}.ds-type{display:grid;grid-template-columns:1fr 1fr;gap:48px}.ds-type h2{font-size:5rem;margin:20px 0}.ds-type-body{font-size:1.5rem;color:var(--text);margin:20px 0}.ds-demo{display:flex;align-items:center;gap:32px;flex-wrap:wrap;margin-top:28px}.ds-demo button{background:var(--card);color:var(--text);min-height:44px}.ds-demo button[aria-pressed=true]{background:var(--brand-violet);color:white}.ds-demo label{display:grid;gap:10px}.ds-demo input{background:var(--card);color:var(--text);border:1px solid var(--border);padding:12px;border-radius:var(--radius-sm)}.ds-demo summary{cursor:pointer;padding:12px;border-bottom:1px solid var(--border)}.ds-space{display:flex;gap:24px;flex-wrap:wrap}.ds-space>div{display:grid;gap:12px}.ds-space span{height:16px;background:var(--brand-violet)}.ds-radii{display:flex;gap:24px;margin-top:40px}.ds-radii>div{width:100px;height:100px;border:1px solid var(--border);display:grid;place-items:center;background:var(--card)}.ds-type h3{margin-bottom:16px}.ds-type .text-link{display:inline-block;margin-top:20px}@media(max-width:760px){.ds-heading,.ds-type{grid-template-columns:1fr}.ds-colors{grid-template-columns:1fr 1fr}.ds-swatch{height:110px}.ds-page{padding-block:48px}.ds-type h2{font-size:3.5rem}.ds-demo{gap:24px}.ds-demo input{max-width:100%}.ds-demo label{max-width:100%}}
</style>
