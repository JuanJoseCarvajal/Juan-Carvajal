---
import { works } from '../../data/content';

export function getStaticPaths() {
  return works.map((project) => ({
    params: { id: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;

if (!project) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.title} | Juan Carvajal</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/favicon.ico" />
    <style>
      :root {
        --accent: #f93202;
        --ink: #161616;
        --muted: #5a5a5a;
        --paper: #ffffff;
        --line: #e0e0e0;
        --panel: #161616;
        --panel-text: #ffffff;
        --panel-muted: #d8d8d8;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        color: var(--ink);
        background: var(--paper);
        font-family: Muli, Avenir, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(255, 255, 255, .94);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(10px);
      }

      nav {
        width: min(960px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 1rem 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .back-link,
      .legacy-link {
        color: var(--accent);
        font-weight: 800;
        text-decoration: none;
      }

      .back-link:hover,
      .legacy-link:hover {
        color: var(--ink);
      }

      main {
        width: min(960px, calc(100% - 2rem));
        margin: 0 auto;
        padding: clamp(2rem, 6vw, 5rem) 0;
      }

      article {
        background: var(--panel);
        color: var(--panel-text);
        border: 1px solid var(--accent);
        border-radius: 8px;
        padding: clamp(1.35rem, 4vw, 3.5rem);
      }

      h1,
      h2 {
        margin: 0;
        font-family: "Saira Extra Condensed", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
        line-height: 1;
        text-transform: uppercase;
      }

      h1 {
        max-width: 12ch;
        font-size: clamp(3rem, 9vw, 6rem);
      }

      h2 {
        color: var(--accent);
        font-size: clamp(1.6rem, 3vw, 2.2rem);
      }

      .company {
        margin: .75rem 0 2rem;
        color: var(--accent);
        font-family: "Saira Extra Condensed", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      section + section {
        margin-top: 1.6rem;
        padding-top: 1.6rem;
        border-top: 1px solid rgba(249, 50, 2, .45);
      }

      p {
        margin: .55rem 0 0;
        color: var(--panel-muted);
      }

      .legacy-link {
        display: inline-flex;
        margin-top: 2rem;
      }

      @media (max-width: 640px) {
        nav {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a class="back-link" href="/#work">Back to work</a>
        <a class="legacy-link" href={`/${project.legacyUrl}`}>Original case-study path</a>
      </nav>
    </header>

    <main>
      <article>
        <h1>{project.title}</h1>
        <p class="company">{project.company}</p>

        <section>
          <h2>Summary</h2>
          <p>{project.shortDescription}</p>
        </section>
        <section>
          <h2>Challenge</h2>
          <p>{project.challenge}</p>
        </section>
        <section>
          <h2>Solution</h2>
          <p>{project.solution}</p>
        </section>
        <section>
          <h2>Impact</h2>
          <p>{project.impact}</p>
        </section>
      </article>
    </main>
  </body>
</html>
