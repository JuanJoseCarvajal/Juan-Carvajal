      function savePriceProductRow(index) {
        const row = document.querySelector(`[data-price-row="${index}"]`);
        if (!row) return;
        const name = row.querySelector('[name="name"]').value.trim();
        const unit = row.querySelector('[name="unit"]').value;
        const priceLb = Number(row.querySelector('[name="priceLb"]').value || 0);
        if (!name) return;
        state.priceList = currentProductCatalog().map((product) => ({ ...product }));
        state.priceList[index] = { name, unit, priceLb };
