      function renderPriceCalculator(values = { costGram: 18, grams: 1000, distMargin: state.settings.distMargin, directMargin: state.settings.directMargin }) {
        const cost = Number(values.costGram || 0) * Number(values.grams || 0);
        const distGram = Number(values.costGram || 0) / (1 - Number(values.distMargin) / 100);
        const directGram = Number(values.costGram || 0) / (1 - Number(values.directMargin) / 100);
        document.querySelector('#priceResults').innerHTML = [
          `<div class="result-box"><span>Precio distribuidor / gramo</span><strong>${money(distGram)}</strong><small>Total ${money(distGram * Number(values.grams || 0))} | Utilidad ${money((distGram * Number(values.grams || 0)) - cost)}</small></div>`,
          `<div class="result-box"><span>Precio directo / gramo</span><strong>${money(directGram)}</strong><small>Total ${money(directGram * Number(values.grams || 0))} | Utilidad ${money((directGram * Number(values.grams || 0)) - cost)}</small></div>`
        ].join('');
      }

      function renderCustomers() {
        document.querySelector('#customersRows').innerHTML = state.customers.map((customer) => {
          const sales = state.sales.filter((sale) => sale.customerId === customer.id);
          const total = sales.reduce((sum, sale) => sum + saleTotal(sale), 0);
          const pending = sales.filter((sale) => !['Pagado', 'Cancelada'].includes(sale.paymentStatus)).reduce((sum, sale) => sum + saleTotal(sale), 0);
          const last = sales.toSorted((a, b) => b.date.localeCompare(a.date))[0]?.date;
          return `<tr><td>${customer.name}</td><td>${customer.type}</td><td>${customer.channel}</td><td>${money(total)}</td><td>${last ? dateLabel(last) : '-'}</td><td>${money(pending)}</td></tr>`;
        }).join('');
      }

      function renderUsers() {
        document.querySelectorAll('[data-user-options]').forEach((select) => {
          select.innerHTML = (state.users || []).map((user) => `<option value="${user.id}">${user.name} | ${user.role}</option>`).join('');
        });
        document.querySelector('#usersRows').innerHTML = (state.users || []).map((user) => `
          <tr>
            <td><strong>${user.name}</strong></td>
            <td>${user.role}</td>
            <td>${user.area}</td>
            <td>${user.email}</td>
            <td>${user.phone || '-'}</td>
            <td>${user.permissions || '-'}</td>
            <td><span class="chip ${user.status === 'Inactivo' ? 'warning' : user.status === 'Invitado' ? 'info' : ''}">${user.status}</span></td>
