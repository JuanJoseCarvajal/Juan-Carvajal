      function enhanceDataTables() {
        document.querySelectorAll('.smart-table-toolbar, .smart-table-footer').forEach((item) => item.remove());
        document.querySelectorAll('.table-wrap table').forEach((table, tableIndex) => {
          if (table.hasAttribute('data-no-smart-table')) return;
          const wrapper = table.closest('.table-wrap');
          const rows = Array.from(table.querySelectorAll('tbody tr'));
          if (!wrapper || rows.length < 2) return;
          const tableId = `smart-table-${tableIndex}`;
          const pageSize = table.closest('.tab-panel') ? 5 : 8;
          let page = 1;
          let query = '';

          const header = wrapper.previousElementSibling?.classList.contains('card-pad') ? wrapper.previousElementSibling : null;
          const toolbar = document.createElement('div');
          toolbar.className = 'smart-table-toolbar';
          toolbar.innerHTML = `
            <div class="inline-search" id="${tableId}-search-shell">
              <input type="search" placeholder="Buscar..." aria-label="Buscar en tabla" />
              <span class="smart-table-search-panel" id="${tableId}-meta"></span>
            </div>
            <button class="btn icon-btn" type="button" aria-label="Buscar en tabla" aria-expanded="false">
              <span class="icon">${icon('search')}</span>
            </button>
          `;
          if (header) {
            header.classList.add('section-head');
            if (!header.firstElementChild?.matches('div:not(.smart-table-toolbar)')) {
              const title = document.createElement('div');
              title.className = 'component-title';
              Array.from(header.childNodes).forEach((node) => title.appendChild(node));
              header.appendChild(title);
            }
            const actions = ensureTitleToolbar(header);
            toolbar.dataset.smartHeader = 'true';
            actions.appendChild(toolbar);
          } else {
            wrapper.prepend(toolbar);
          }

          const footer = document.createElement('div');
          footer.className = 'smart-table-footer';
          footer.innerHTML = `
            <span class="smart-table-meta" id="${tableId}-footer"></span>
            <div class="smart-table-pages" aria-label="Paginacion"></div>
          `;
          wrapper.after(footer);

          const search = toolbar.querySelector('input');
          const searchShell = toolbar.querySelector('.inline-search');
          const searchButton = toolbar.querySelector('.icon-btn');
          const pages = footer.querySelector('.smart-table-pages');
          const meta = toolbar.querySelector(`#${tableId}-meta`);
          const footerMeta = footer.querySelector(`#${tableId}-footer`);

          searchButton.addEventListener('click', () => {
            const nextOpen = !searchShell.classList.contains('is-open');
            searchShell.classList.toggle('is-open', nextOpen);
            searchButton.setAttribute('aria-expanded', nextOpen ? 'true' : 'false');
            if (nextOpen) {
              search.focus();
            } else {
              search.value = '';
              query = '';
              page = 1;
              apply();
            }
          });

          table.querySelectorAll('thead th').forEach((th, columnIndex) => {
            const label = th.querySelector('.sort-button')?.textContent.trim() || th.textContent.trim();
            th.innerHTML = '';
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'sort-button';
            button.textContent = label;
            button.addEventListener('click', () => {
              const current = button.dataset.dir === 'asc' ? 'desc' : 'asc';
              table.querySelectorAll('.sort-button').forEach((item) => item.removeAttribute('data-dir'));
              button.dataset.dir = current;
              rows.sort((a, b) => {
                const aText = a.children[columnIndex]?.textContent.trim() || '';
                const bText = b.children[columnIndex]?.textContent.trim() || '';
                const aNumber = Number(aText.replace(/[^\d.-]/g, ''));
                const bNumber = Number(bText.replace(/[^\d.-]/g, ''));
                const compared = Number.isFinite(aNumber) && Number.isFinite(bNumber) && aText.match(/\d/) && bText.match(/\d/)
                  ? aNumber - bNumber
                  : aText.localeCompare(bText, 'es', { numeric: true });
                return current === 'asc' ? compared : -compared;
              });
              rows.forEach((row) => table.tBodies[0].appendChild(row));
              page = 1;
              apply();
            });
            th.appendChild(button);
          });

          const apply = () => {
            const filtered = rows.filter((row) => row.textContent.toLowerCase().includes(query));
            const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
            page = Math.min(page, totalPages);
            rows.forEach((row) => row.dataset.smartHidden = 'true');
            filtered.forEach((row, index) => {
              row.dataset.smartHidden = index < (page - 1) * pageSize || index >= page * pageSize ? 'true' : 'false';
            });
            meta.textContent = `${filtered.length} resultados`;
            footerMeta.textContent = `Pagina ${page} de ${totalPages}`;
            pages.innerHTML = `
              <button class="btn icon-btn" type="button" data-direction="previous" aria-label="Pagina anterior" ${page === 1 ? 'disabled' : ''}><span class="icon">${icon('collapse')}</span></button>
              <button class="btn icon-btn" type="button" data-direction="next" aria-label="Pagina siguiente" ${page === totalPages ? 'disabled' : ''}><span class="icon">${icon('expand')}</span></button>
            `;
          };

          search.addEventListener('input', (event) => {
            query = event.target.value.toLowerCase().trim();
            page = 1;
            apply();
          });
          pages.addEventListener('click', (event) => {
            const button = event.target.closest('[data-direction]');
            if (!button) return;
            page += button.dataset.direction === 'next' ? 1 : -1;
            apply();
          });
          apply();
        });
        renderStaticIcons();
      }

