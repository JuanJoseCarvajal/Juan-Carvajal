            results.push({ label: item.label, detail: item.subtitle, target: item.id, icon: item.icon });
          }
        });
        state.lots.forEach((lot) => {
          const text = `${lot.id} ${lot.supplier} ${lot.breed} ${lot.house} ${lotStatus(lot)}`;
          if (normalized && text.toLowerCase().includes(normalized)) {
            results.push({ label: lot.id, detail: `${lotStatus(lot)} | ${lotLiveBirds(lot)} aves vivas`, target: 'lotes', icon: 'lots' });
          }
        });
        state.customers.forEach((customer) => {
          const text = `${customer.name} ${customer.type} ${customer.city} ${customer.channel}`;
          if (normalized && text.toLowerCase().includes(normalized)) {
            results.push({ label: customer.name, detail: `${customer.type} | ${customer.channel}`, target: 'clientes', icon: 'users' });
          }
        });
        (state.users || []).forEach((user) => {
          const text = `${user.name} ${user.email} ${user.role} ${user.area} ${user.status}`;
          if (normalized && text.toLowerCase().includes(normalized)) {
            results.push({ label: user.name, detail: `${user.role} | ${user.area}`, target: 'usuarios', icon: 'users' });
          }
        });
        document.querySelector('#searchResults').innerHTML = results.slice(0, 8).map((result) => `
          <button type="button" data-search-target="${result.target}">
            <strong><span class="nav-icon">${icon(result.icon)}</span>${result.label}</strong>
            <small>${result.detail}</small>
          </button>
        `).join('') || '<button type="button" disabled><strong>Sin resultados</strong><small>Prueba con otro termino</small></button>';
