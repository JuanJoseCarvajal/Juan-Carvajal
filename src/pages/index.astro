      function plannerImpactText(nextPlanner) {
        const nextChicks = Math.ceil(Number(nextPlanner.commercialBirds || 0) / (1 - Number(nextPlanner.expectedMortality || 0) / 100));
        const nextSimultaneous = Math.ceil(Number(nextPlanner.cycleDays || 0) / Number(nextPlanner.intervalDays || 1));
        const nextCapacity = nextChicks * nextSimultaneous;
        const currentChicks = recommendedChicks();
        const currentSimultaneous = Math.ceil(Number(state.planner.cycleDays || 0) / Number(state.planner.intervalDays || 1));
        const currentCapacity = currentChicks * currentSimultaneous;
        const status = nextCapacity > nextPlanner.capacity
          ? 'El nuevo plan supera la capacidad configurada.'
          : 'El nuevo plan queda dentro de la capacidad configurada.';
        return `${status} Pasarias de ${currentChicks} a ${nextChicks} pollitos por lote, de ${currentSimultaneous} a ${nextSimultaneous} lotes simultaneos y de ${currentCapacity} a ${nextCapacity} aves requeridas. Esto afecta fechas sugeridas, alertas de capacidad y recomendaciones del calendario.`;
      }

