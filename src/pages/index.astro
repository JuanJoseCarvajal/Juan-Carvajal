---
import { education, experiences, works } from '../data/content';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portafolio Astro</title>
    <link rel="stylesheet" href="/theme.css" />
    <script is:inline src="/theme.js"></script>
    <style>
      :root { --header-height: 80px; }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Inter, system-ui, sans-serif;
        background: var(--surface);
        color: var(--text);
      }

      header {
        position: sticky;
        top: 0;
        background: var(--surface);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
        z-index: 100;
      }

      nav {
        max-width: 1100px;
        margin: auto;
        display: flex;
        gap: 1rem;
        align-items: center;
        padding: 1rem;
        overflow-x: auto;
      }

      nav a {
        color: var(--text);
        text-decoration: none;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: .4rem .8rem;
        white-space: nowrap;
        transition: all .2s ease;
      }

      nav a:hover { border-color: var(--accent); color: var(--accent); }
      nav a.is-active {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
      }

      .nav-controls {
        margin-left: auto;
        display: flex;
        gap: .6rem;
        align-items: center;
      }

      .theme-switcher {
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        color: var(--text);
        padding: .4rem .8rem;
        font: inherit;
      }

      main { max-width: 1100px; margin: auto; }

      section {
        min-height: 100vh;
        scroll-margin-top: calc(var(--header-height) + 6px);
        padding: 3rem 1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0; }
      h2 { font-size: 1.8rem; margin-top: 0; }
      p { color: var(--muted); line-height: 1.7; }
      .hero { display: grid; gap: 1rem; }

      .about-banner {
        width: 100%;
        aspect-ratio: 16 / 6;
        object-fit: cover;
        border-radius: 1rem;
        border: 1px solid var(--border);
      }

      .carousel {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(260px, 340px);
        gap: 1rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: .5rem;
      }

      .card {
        scroll-snap-align: start;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 1rem;
        padding: 1rem;
      }

      .card h3 { margin: 0; }

      .cta {
        margin-top: 1rem;
        display: inline-block;
        background: var(--accent);
        color: var(--text);
        padding: .5rem .8rem;
        border: 0;
        border-radius: .5rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
      }

      .simple-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
      }

      form {
        display: grid;
        gap: .75rem;
        max-width: 580px;
      }

      input, textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: .5rem;
        background: var(--surface);
        color: var(--text);
        padding: .7rem;
      }

      .modal {
        position: fixed;
        inset: 0;
        background: var(--surface);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .modal.open { display: flex; }

      .modal-content {
        width: min(680px, 100%);
        background: var(--surface);
        border-radius: 1rem;
        border: 1px solid var(--border);
        padding: 1.25rem;
      }

      .modal-close {
        float: right;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text);
        border-radius: .4rem;
        padding: .2rem .5rem;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <header id="main-header">
      <nav aria-label="Principal">
        <a class="nav-link" href="#about">Acerca de</a>
        <a class="nav-link" href="#experience">Experiencia</a>
        <a class="nav-link" href="#education">Educación</a>
        <a class="nav-link" href="#work">Proyectos</a>
        <a class="nav-link" href="#contact">Contacto</a>
        <div class="nav-controls">
          <button class="theme-switcher" id="theme-switcher" type="button" aria-label="Cambiar tema">
            🌙 Dark
          </button>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero" id="about" data-section>
        <h1>Hola, soy Juan 👋</h1>
        <p>Durante más de 12 años, me ha movido una pregunta sencilla: ¿por qué algunas experiencias digitales se sienten naturales y fluidas, mientras otras generan fricción que no siempre sabemos explicar? Esa curiosidad fue lo que me llevó al diseño—no solo de interfaces, sino de la lógica invisible detrás de cómo las personas piensan, sienten y se mueven dentro de la tecnología. Con el tiempo, he evolucionado hacia el rol de Experience Architect, trabajando en la intersección entre comportamiento humano, diseño y estrategia de negocio. Para mí, cada producto es un sistema vivo, donde deben alinearse las necesidades del usuario, los objetivos del negocio y las posibilidades tecnológicas. Mi trabajo consiste en dar claridad a esa complejidad y transformar esa tensión en experiencias que se sientan naturales y generen impacto real. Mi enfoque está profundamente influenciado por la psicología, el psicoanálisis y los factores humanos. Me interesa observar lo sutil: la pausa antes de un clic, la duda en un flujo, ese momento en que el usuario se siente perdido o, por el contrario, completamente en control. A partir de ahí, diseño experiencias que anticipan necesidades, reducen la carga cognitiva y generan una sensación de fluidez que, aunque muchas veces pasa desapercibida, siempre se percibe. Con los años he entendido que el buen diseño no es solo usabilidad, sino alineación. Alineación entre lo que el usuario necesita y lo que el negocio busca lograr. Ya sea optimizando un funnel de e-commerce, estructurando una plataforma compleja o construyendo sistemas de diseño escalables, abordo cada reto desde una mirada estratégica, conectando cada decisión con resultados como crecimiento, retención y valor a largo plazo. También disfruto ser un puente entre mundos. Mi experiencia en user research, arquitectura de información y desarrollo front-end me permite moverme con fluidez entre la estrategia y la ejecución, aterrizando ideas en soluciones concretas. Trabajo de cerca con equipos multidisciplinarios—producto, tecnología y stakeholders—para construir experiencias que no solo funcionen, sino que tengan sentido. En el fondo, creo que diseñar es una forma de cuidado. Es quitar lo innecesario, dar claridad donde hay confusión y crear productos que respeten el tiempo y la atención de las personas. Cuando el diseño está bien hecho, no se nota: simplemente fluye, se siente correcto y permite avanzar sin esfuerzo. Ese es el tipo de experiencia que busco crear todos los días.</p>
      </section>

      <section id="experience" data-section>
        <h2>Experiencia</h2>
        <div class="carousel" aria-label="Carrusel de experiencia">
          {experiences.map((item) => (
            <article class="card">
              <h3>{item.role}</h3>
              <p><strong>{item.company}</strong> · {item.period}</p>
              <p>{item.summary}</p>
              <button class="cta experience-cta" data-id={item.id}><span>Ver más</span></button>
            </article>
          ))}
        </div>
      </section>

      <section id="education" data-section>
        <h2>Educación</h2>
        <div class="simple-grid">
          {education.map((item, index) => (
            <article class="card">
              <h3>{item.title}</h3>
              <p>{item.institution}</p>
              <p>{item.period}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="work" data-section>
        <h2>Proyectos</h2>
        <div class="simple-grid">
          {works.map((item) => (
            <article class="card">
              <h3>{item.title}</h3>
              <p>{item.shortDescription}</p>
              <a class="cta" href={`/work/${item.slug}`}>Ver caso completo</a>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" data-section>
        <h2>Contacto</h2>
        <form>
          <label><span>Nombre</span><input name="name" required /></label>
          <label><span>Email</span><input type="email" name="email" required /></label>
          <label><span>Mensaje</span><textarea name="message" rows="5" required></textarea></label>
          <button class="cta" type="submit">Enviar</button>
        </form>
      </section>
    </main>

    <div class="modal" id="experience-modal" aria-hidden="true">
      <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button class="modal-close" id="close-modal">Cerrar</button>
        <h3 id="modal-title"></h3>
        <p id="modal-meta"></p>
        <p id="modal-body"></p>
      </div>
    </div>

    <script define:vars={{ experiences }}>
      document.addEventListener('DOMContentLoaded', () => {
        window.initializeThemeSwitcher('theme-switcher');

        // Modal functionality
        const modal = document.getElementById('experience-modal');
        const closeBtn = document.getElementById('close-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalMeta = document.getElementById('modal-meta');
        const modalBody = document.getElementById('modal-body');

        document.querySelectorAll('.experience-cta').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.dataset.id;
            const experience = experiences.find(exp => exp.id === id);
            if (experience) {
              modalTitle.textContent = experience.role;
              modalMeta.innerHTML = `<strong>${experience.company}</strong> · ${experience.period}`;
              modalBody.textContent = experience.details;
              modal.classList.add('open');
              modal.setAttribute('aria-hidden', 'false');
            }
          });
        });

        closeBtn.addEventListener('click', () => {
          modal.classList.remove('open');
          modal.setAttribute('aria-hidden', 'true');
        });

        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.remove('open');
            modal.setAttribute('aria-hidden', 'true');
          }
        });
      });
    </script>
  </body>
</html>
