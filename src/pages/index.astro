        if (sidebarToggle) sidebarToggle.innerHTML = `<span class="icon">${icon(document.body.classList.contains('is-sidebar-collapsed') ? 'expand' : 'collapse')}</span>`;
      }

      function number(value, digits = 1) {
        return (Number(value) || 0).toLocaleString('es-CO', { maximumFractionDigits: digits });
      }

      function escapeAttr(value) {
        return String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('"', '&quot;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;');
      }

      function escapeHtml(value) {
        return String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;');
      }

      function clampPercent(value) {
        return Math.max(0, Math.min(100, Number(value) || 0));
      }

      function kgToLb(value) {
        return Number(value || 0) * 2.20462;
      }

      function currentProductCatalog() {
        return state.priceList?.length ? state.priceList : productCatalog;
      }

      function lotDeaths(lotId) {
        const dailyDeaths = state.daily.filter((r) => r.lotId === lotId).reduce((sum, r) => sum + Number(r.deaths || 0), 0);
        const mortalityDeaths = state.mortality.filter((r) => r.lotId === lotId).reduce((sum, r) => sum + Number(r.quantity || 0), 0);
        return dailyDeaths + mortalityDeaths;
      }

      function latestWeight(lotId) {
        const dailyWeights = state.daily.filter((r) => r.lotId === lotId && Number(r.avgWeight) > 0).map((r) => ({ date: r.date, avgWeight: Number(r.avgWeight) }));
        const weights = state.weights.filter((r) => r.lotId === lotId && Number(r.avgWeight) > 0);
        return [...dailyWeights, ...weights].sort((a, b) => a.date.localeCompare(b.date)).at(-1)?.avgWeight || 0;
      }

      function feedCostFor(type, kg) {
        const item = state.feedInventory.find((feed) => feed.type === type);
        return Number(kg || 0) * Number(item?.costPerKg || 0);
      }

      function lotFeedKg(lotId) {
        return state.daily.filter((r) => r.lotId === lotId).reduce((sum, r) => sum + Number(r.feedKg || 0), 0);
      }

      function lotFeedCost(lotId) {
        return state.daily.filter((r) => r.lotId === lotId).reduce((sum, r) => sum + feedCostFor(r.feedType, r.feedKg), 0);
      }

      function lotExpenseCost(lotId) {
        return state.expenses
          .filter((e) => e.lotId === lotId || e.lotId === 'farm')
          .reduce((sum, e) => sum + Number(e.amount || 0), 0);
      }

      function lotProcessingCost(lotId) {
        return state.processing
          .filter((p) => p.lotId === lotId)
          .reduce((sum, p) => sum + Number(p.birds || 0) * Number(p.slaughterCost || 0) + Number(p.packingCost || 0) + Number(p.transportCost || 0), 0);
      }

      function productPrice(productName) {
        const catalog = currentProductCatalog();
        const product = catalog.find((item) => item.name === productName) || catalog[0];
        return product.priceLb;
      }

      function processingBillableLb(processing) {
        return Number(processing.billableLb || processing.billableKg || kgToLb(processing.carcassKg));
      }

      function processingUnitCost(processing) {
        const lot = state.lots.find((item) => item.id === processing.lotId);
        const totalCost = lot ? lotCost(lot) : lotProcessingCost(processing.lotId);
        return totalCost / Math.max(1, processingBillableLb(processing));
      }

      function processingPotentialBilling(processing) {
        const lb = processingBillableLb(processing);
        return lb * productPrice(processing.product || currentProductCatalog()[0].name);
      }

      function lotSalesTotal(lotId) {
        return state.sales.filter((s) => s.lotId === lotId).reduce((sum, s) => sum + saleTotal(s), 0);
      }

      function lotCommercialKg(lotId) {
        const processedKg = state.processing.filter((p) => p.lotId === lotId).reduce((sum, p) => sum + Number(p.carcassKg || 0), 0);
        if (processedKg) return processedKg;
        const lot = state.lots.find((item) => item.id === lotId);
        return lotLiveBirds(lot) * latestWeight(lotId) * 0.74;
      }

      function lotLiveBirds(lot) {
        return Math.max(0, Number(lot.chicks || 0) - lotDeaths(lot.id));
      }

      function lotCost(lot) {
        return Number(lot.chicks || 0) * Number(lot.chickCost || 0) + lotFeedCost(lot.id) + lotExpenseCost(lot.id) + lotProcessingCost(lot.id);
      }

      function lotStatus(lot) {
        if (state.sales.some((s) => s.lotId === lot.id && s.paymentStatus !== 'Cancelada')) return 'Cerrado';
        if (state.processing.some((p) => p.lotId === lot.id)) return 'Procesado';
        const age = daysBetween(lot.entryDate);
        if (age >= Number(lot.targetAge || 49)) return 'Listo para procesamiento';
        if (age >= 42) return 'Proximo a salida';
        if (age >= 28) return 'Engorde';
        if (age >= 14) return 'Crecimiento';
        return 'Inicio';
      }

      function sortedLots() {
        return state.lots.toSorted((a, b) => b.entryDate.localeCompare(a.entryDate) || b.id.localeCompare(a.id));
      }

      function fcr(lot) {
        const kgProduced = lotLiveBirds(lot) * latestWeight(lot.id);
        return kgProduced > 0 ? lotFeedKg(lot.id) / kgProduced : 0;
      }

      function getMetrics() {
        const activeLots = state.lots.filter((lot) => !['Cerrado', 'Procesado'].includes(lotStatus(lot)));
        const currentBirds = activeLots.reduce((sum, lot) => sum + lotLiveBirds(lot), 0);
        const costs = state.lots.reduce((sum, lot) => sum + lotCost(lot), 0);
        const sales = state.sales.reduce((sum, sale) => sum + saleTotal(sale), 0);
        const commercialBirds = state.processing.reduce((sum, p) => sum + Number(p.birds || 0), 0) || state.lots.reduce((sum, lot) => sum + lotLiveBirds(lot), 0);
        const commercialKg = state.processing.reduce((sum, p) => sum + Number(p.carcassKg || 0), 0) || state.lots.reduce((sum, lot) => sum + lotCommercialKg(lot.id), 0);
        const profit = sales - costs;
        const avgMortality = state.lots.length ? state.lots.reduce((sum, lot) => sum + lotDeaths(lot.id) / Number(lot.chicks || 1), 0) / state.lots.length * 100 : 0;
        const avgFcr = activeLots.length ? activeLots.reduce((sum, lot) => sum + fcr(lot), 0) / activeLots.length : 0;
        const avgWeight = activeLots.length ? activeLots.reduce((sum, lot) => sum + latestWeight(lot.id), 0) / activeLots.length : 0;
        const avgAge = activeLots.length ? activeLots.reduce((sum, lot) => sum + daysBetween(lot.entryDate), 0) / activeLots.length : 0;
        return { activeLots, currentBirds, costs, sales, commercialBirds, commercialKg, profit, avgMortality, avgFcr, avgWeight, avgAge };
      }

      function renderNavigation() {
        document.querySelector('#desktopNav').innerHTML = navSections.map((section) => `
          <div class="nav-group">
            <div class="nav-group-title">${section.title}</div>
            ${section.items.map((item) => `
              <button type="button" data-section="${item.id}" aria-label="${item.label}" title="${item.label}">
                <span class="nav-icon">${icon(item.icon)}</span>
                <span class="nav-label">${item.label}</span>
              </button>
            `).join('')}
          </div>
        `).join('');
        document.querySelector('#mobileMenu').innerHTML = navItems.map((item) => `
          <button type="button" data-section="${item.id}">
            <span class="nav-icon">${icon(item.icon)}</span>
            <span>${item.label}</span>
          </button>
        `).join('');
        renderStaticIcons();
      }

      function showSection(id) {
        document.querySelectorAll('.section').forEach((section) => section.classList.toggle('is-active', section.id === id));
        document.querySelectorAll('[data-section]').forEach((button) => button.classList.toggle('is-active', button.dataset.section === (id === 'lote-detalle' ? 'lotes' : id)));
        const section = document.getElementById(id);
        syncSectionHeader(section, id);
        if (id !== 'procesamiento') {
          document.querySelector('#processingSearchShell').classList.remove('is-open');
          document.querySelector('#processingSearchToggle').setAttribute('aria-expanded', 'false');
          document.querySelector('#processingSearch').value = '';
          processingQuery = '';
        }
        document.querySelector('#mobileNav').classList.remove('is-open');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function syncSectionHeader(section, id) {
        const source = pageHeadingSource(section);
        if (!source) return;
        ensureTitleIcon(source, sectionIcon(id));
        ensureInfoAction(source, id);
      }

      function pageHeadingSource(section) {
        if (!section) return null;
        const selectors = [
          ':scope > .calendar-shell article.card > .section-head',
          ':scope > article.card > .card-pad.section-head',
          ':scope > article.card > .section-head',
          ':scope > .grid > article.card:has(.table-wrap) > .card-pad.section-head',
          ':scope > .grid > article.card:has(.table-wrap) > .card-pad',
          ':scope > .dashboard-top .production-plan-card .section-head'
        ];
        return selectors.map((selector) => section.querySelector(selector)).find((item) => item?.querySelector('h2')) || null;
      }

      function sectionIcon(id) {
        return navItems.find((item) => item.id === (id === 'lote-detalle' ? 'lotes' : id))?.icon || 'dashboard';
      }

      function ensureTitleIcon(header, iconName) {
        const title = header.querySelector(':scope > div:first-child');
        if (!title || title.querySelector('.component-title-icon')) return;
        title.classList.add('component-title');
        title.insertAdjacentHTML('afterbegin', `<span class="component-title-icon icon">${icon(iconName)}</span>`);
      }

      function ensureInfoAction(header, topicId) {
        const actions = ensureTitleToolbar(header);
        if (actions.querySelector('[data-component-info]')) return;
        const button = document.createElement('button');
        button.className = 'btn icon-btn';
        button.type = 'button';
        button.dataset.componentInfo = 'true';
        button.dataset.infoTopic = topicId;
        button.setAttribute('aria-label', 'Informacion de la funcionalidad');
        button.innerHTML = `<span class="icon">${icon('info')}</span>`;
        actions.prepend(button);
      }

      function openLotDetail(lotId) {
        activeLotId = lotId || sortedLots()[0]?.id || null;
        const detailSelect = document.querySelector('#lotDetailSelect');
        if (detailSelect && activeLotId) detailSelect.value = activeLotId;
        showSection('lote-detalle');
        renderLotDetail(activeLotId);
      }

      function metricCard(label, value, helper) {
        return `<article class="card metric"><span>${label}</span><strong>${value}</strong><small>${helper}</small></article>`;
      }

      function sectionLabel(id) {
        return navItems.find((item) => item.id === id)?.label || 'detalle';
      }

      function dashboardKpiCard({ label, value, helper, target, iconName, progress, chip = 'Ver detalle', tone = 'info' }) {
        const progressMarkup = progress == null ? '' : `<div class="progress"><span style="--value:${clampPercent(progress)}%"></span></div>`;
        return `
          <article class="card metric metric-action" role="button" tabindex="0" data-jump="${target}">
            <div class="metric-top">
              <span>${label}</span>
              <span class="icon">${icon(iconName)}</span>
            </div>
            <strong>${value}</strong>
            <small>${helper}</small>
            ${progressMarkup}
            <footer><span>Ir a ${sectionLabel(target)}</span><span class="chip ${tone}">${chip}</span></footer>
          </article>
        `;
      }

      function chartRow(label, value, percent) {
        return `
          <div class="chart-row">
            <div class="chart-row-header"><span>${label}</span><strong>${value}</strong></div>
            <div class="progress"><span style="--value:${clampPercent(percent)}%"></span></div>
          </div>
        `;
      }

      function dashboardInsightCard({ title, subtitle, iconName, chart, footer, chip = 'Abrir', tone = 'info' }) {
        return `
          <div>
            <div class="insight-title">
              <div>
                <h2>${title}</h2>
                <p>${subtitle}</p>
              </div>
              <span class="icon">${icon(iconName)}</span>
            </div>
          </div>
          <div class="dashboard-chart">${chart}</div>
          <footer class="insight-footer"><span>${footer}</span><span class="chip ${tone}">${chip}</span></footer>
        `;
      }

      function stateChip(status) {
        const cls = status.includes('Listo') || status.includes('Proximo') ? 'warning' : status === 'Cerrado' ? 'info' : '';
        return `<span class="chip ${cls}">${status}</span>`;
      }

      function renderDashboard() {
        const m = getMetrics();
        const nextEntry = addDays(state.lots.toSorted((a, b) => b.entryDate.localeCompare(a.entryDate))[0]?.entryDate || new Date().toISOString().slice(0, 10), state.planner.intervalDays);
        const nextExit = state.lots
          .map((lot) => ({ lot, exit: addDays(lot.entryDate, lot.targetAge || state.planner.cycleDays) }))
          .filter((item) => new Date(`${item.exit}T00:00:00`) >= new Date(new Date().toDateString()))
          .sort((a, b) => a.exit.localeCompare(b.exit))[0];
        const chicks = recommendedChicks();
        const freeCapacity = Number(state.planner.capacity || 0) - m.currentBirds;
        const capacityStatus = freeCapacity >= chicks ? 'Hay espacio para el siguiente lote' : `Faltan ${Math.abs(freeCapacity - chicks)} cupos para ingresar sin sobrecargar`;
        const fcrGap = Number(state.settings.acceptableFcr || 0) - m.avgFcr;
        const capacityPct = state.planner.capacity ? m.currentBirds / state.planner.capacity * 100 : 0;
        const mortalityPct = state.settings.mortalityAlert ? m.avgMortality / state.settings.mortalityAlert * 100 : 0;
        const targetWeight = m.activeLots.length ? m.activeLots.reduce((sum, lot) => sum + Number(lot.targetWeight || 0), 0) / m.activeLots.length : 0;
        const weightPct = targetWeight ? m.avgWeight / targetWeight * 100 : 0;
        const processedLb = state.processing.reduce((sum, item) => sum + processingBillableLb(item), 0);
        const potentialBilling = state.processing.reduce((sum, item) => sum + processingPotentialBilling(item), 0);
        const pendingSales = state.sales.filter((sale) => !['Pagado', 'Cancelada'].includes(sale.paymentStatus)).reduce((sum, sale) => sum + saleTotal(sale), 0);
        const totalInventoryValue = state.inventory.reduce((sum, item) => sum + Number(item.qty || 0) * Number(item.cost || 0), 0);
        const marginPct = m.sales ? (m.sales - m.costs) / m.sales * 100 : 0;
        const readyLots = m.activeLots.filter((lot) => ['Listo para procesamiento', 'Proximo a salida'].includes(lotStatus(lot))).length;
        const lowFeed = state.feedInventory.filter((feed) => Number(feed.kg || 0) <= Number(feed.min || 0)).length;
        document.querySelector('#dashboardMetrics').innerHTML = [
          dashboardKpiCard({
            label: 'Resumen ejecutivo',
            value: money(m.profit),
            helper: `${number(marginPct, 1)}% margen bruto con ${money(m.sales)} en ventas`,
            target: 'reportes',
            iconName: 'reports',
            progress: Math.max(0, marginPct),
            chip: marginPct >= 25 ? 'Saludable' : 'Revisar',
            tone: marginPct >= 25 ? 'info' : 'warning'
          }),
          dashboardKpiCard({
            label: 'Operacion viva',
            value: `${m.currentBirds} aves`,
            helper: `${Math.max(0, freeCapacity)} cupos disponibles. ${capacityStatus}`,
            target: 'lotes',
            iconName: 'lots',
            progress: capacityPct,
            chip: freeCapacity >= chicks ? 'Planificar' : 'Capacidad',
            tone: freeCapacity >= chicks ? 'info' : 'danger'
          }),
          dashboardKpiCard({
            label: 'Produccion lista',
            value: nextExit ? nextExit.lot.id : 'Sin salida',
            helper: nextExit ? `${dateLabel(nextExit.exit)} | ${readyLots} lote(s) cerca de salida` : 'Crea un lote para proyectar procesamiento',
            target: 'procesamiento',
            iconName: 'process',
            progress: readyLots ? 100 : 18,
            chip: readyLots ? 'Procesar' : 'Preparar',
            tone: readyLots ? 'warning' : 'info'
          }),
          dashboardKpiCard({
            label: 'Negocio y cartera',
            value: money(m.sales),
            helper: pendingSales ? `${money(pendingSales)} pendiente por cobrar` : 'Cartera al dia en registros actuales',
            target: 'ventas',
            iconName: 'sales',
            progress: m.sales ? (m.sales - pendingSales) / m.sales * 100 : 0,
            chip: pendingSales ? 'Cobrar' : 'Vender',
            tone: pendingSales ? 'danger' : 'info'
          })
        ].join('');
        document.querySelector('#dashboardOperationCard').innerHTML = dashboardInsightCard({
          title: 'Operacion',
          subtitle: 'Estado vivo de lotes, alimento y desempeno productivo.',
          iconName: 'lots',
          chart: [
            chartRow('Capacidad usada', `${number(capacityPct, 0)}%`, capacityPct),
            chartRow('Peso vs objetivo', `${number(weightPct, 0)}%`, weightPct),
            chartRow('Mortalidad vs meta', `${number(m.avgMortality, 2)}%`, mortalityPct)
          ].join(''),
          footer: lowFeed ? `${lowFeed} alimento(s) bajo minimo` : `${m.activeLots.length} lote(s) activos en seguimiento`,
          chip: lowFeed ? 'Reponer' : 'Gestionar',
          tone: lowFeed ? 'warning' : 'info'
        });
        document.querySelector('#dashboardBusinessCard').innerHTML = dashboardInsightCard({
          title: 'Negocio',
          subtitle: 'Ventas, cartera y valor disponible para facturar.',
          iconName: 'sales',
          chart: `
            <div class="comparison-bars">
              <div class="comparison-item"><span>Ventas</span><strong>${money(m.sales)}</strong><small>${state.sales.length} registros</small></div>
              <div class="comparison-item"><span>Cartera</span><strong>${money(pendingSales)}</strong><small>${pendingSales ? 'accion de cobro' : 'sin pendientes'}</small></div>
            </div>
            ${chartRow('Facturacion potencial', money(potentialBilling), potentialBilling ? 100 : 0)}
            ${chartRow('Inventario valorizado', money(totalInventoryValue), totalInventoryValue ? 76 : 0)}
          `,
          footer: pendingSales ? 'Prioriza recaudo antes de abrir mas credito.' : 'Buen momento para empujar venta directa.',
          chip: 'Vender',
          tone: pendingSales ? 'danger' : 'info'
        });
        document.querySelector('#dashboardSummaryCard').innerHTML = dashboardInsightCard({
          title: 'Resumen',
          subtitle: 'Rentabilidad general y oportunidad de mejora.',
          iconName: 'reports',
          chart: `
            <div class="donut-row">
              <div class="mini-donut" style="--donut-value:${clampPercent(Math.max(0, marginPct))}%; --donut-color: var(--brand);"><span>${number(marginPct, 1)}%</span></div>
              <div class="insight-copy">
                <strong>${fcrGap >= 0 ? 'La conversion esta dentro de meta.' : `Bajar FCA ${number(Math.abs(fcrGap), 2)} puntos mejora margen.`}</strong>
                <p>${processedLb ? `${number(processedLb, 0)} lb facturables registradas.` : 'Registra procesamiento para proyectar facturacion real.'}</p>
              </div>
            </div>
            ${chartRow('Costo vs ventas', money(m.costs), m.sales ? m.costs / m.sales * 100 : 0)}
          `,
          footer: `Proximo ingreso sugerido: ${dateLabel(nextEntry)}`,
          chip: 'Analizar',
          tone: marginPct >= 25 ? 'info' : 'warning'
        });
        renderAlerts();
        renderPlannerSummary();
      }

      function lotRow(lot, compact = false) {
        const deaths = lotDeaths(lot.id);
        const live = lotLiveBirds(lot);
        const cost = lotCost(lot);
        const costKg = lotCommercialKg(lot.id) ? cost / lotCommercialKg(lot.id) : 0;
        if (compact) {
          return `<tr><td><strong>${lot.id}</strong></td><td>${daysBetween(lot.entryDate)} dias</td><td>${live}</td><td>${number(deaths / lot.chicks * 100, 2)}%</td><td>${number(latestWeight(lot.id), 2)} kg</td><td>${number(lotFeedKg(lot.id), 1)} kg</td><td>${money(cost)}</td><td>${money(live ? cost / live : 0)}</td><td>${stateChip(lotStatus(lot))}</td></tr>`;
        }
        return `<tr><td><strong>${lot.id}</strong></td><td>${dateLabel(lot.entryDate)}</td><td>${dateLabel(addDays(lot.entryDate, lot.targetAge))}</td><td>${lot.chicks}</td><td>${live}</td><td>${money(cost)}</td><td>${money(costKg)}</td><td>${stateChip(lotStatus(lot))}</td><td><div class="row-actions"><button class="btn icon-btn" type="button" data-lot-select="${lot.id}" aria-label="Ver detalle de ${lot.id}"><span class="icon">${icon('search')}</span></button></div></td></tr>`;
      }

      function renderLots() {
        const orderedLots = sortedLots();
        document.querySelector('#lotsRows').innerHTML = orderedLots.map((lot) => lotRow(lot)).join('');
        const selects = document.querySelectorAll('[data-lot-options]');
        selects.forEach((select) => {
          const keepFarm = select.querySelector('option[value="farm"]') ? '<option value="farm">Toda la granja</option>' : '';
          select.innerHTML = keepFarm + orderedLots.map((lot) => `<option value="${lot.id}">${lot.id}</option>`).join('');
        });
        const detailSelect = document.querySelector('#lotDetailSelect');
        const selected = activeLotId || detailSelect.value || orderedLots[0]?.id;
        detailSelect.innerHTML = orderedLots.map((lot) => `<option value="${lot.id}">${lot.id} | ingreso ${dateLabel(lot.entryDate)}</option>`).join('');
        detailSelect.value = orderedLots.some((lot) => lot.id === selected) ? selected : orderedLots[0]?.id;
        activeLotId = detailSelect.value || null;
        renderLotDetail(detailSelect.value || orderedLots[0]?.id);
      }

      function renderLotDetail(lotId) {
        const lot = state.lots.find((item) => item.id === lotId) || state.lots[0];
        if (!lot) return;
        activeLotId = lot.id;
        document.querySelector('#lotDetailTitle').textContent = `Lote ${lot.id}`;
        if (document.querySelector('#lote-detalle').classList.contains('is-active')) {
          document.querySelector('#pageTitle').textContent = `Detalle de lote / Lote ${lot.id}`;
          document.querySelector('#pageSubtitle').textContent = `${lotStatus(lot)} | ingreso ${dateLabel(lot.entryDate)} | salida estimada ${dateLabel(addDays(lot.entryDate, lot.targetAge))}`;
          document.querySelector('#lotDetailTitle').closest('.section-head')?.classList.add('is-page-title-source');
        }
        const tabs = ['Resumen', 'Registro diario', 'Alimentacion', 'Pesajes', 'Mortalidad', 'Gastos', 'Procesamiento', 'Ventas', 'Rentabilidad'];
        document.querySelector('#lotTabs').innerHTML = tabs.map((tab, index) => `<button type="button" data-tab="${index}" class="${index === 0 ? 'is-active' : ''}">${tab}</button>`).join('');
        document.querySelector('#lotOperationNav').innerHTML = lotOperationItems(lot).map((item) => `
          <button type="button" data-lot-tab="${item.tab}" class="${item.tab === 0 ? 'is-active' : ''}">
            <span class="icon">${icon(item.icon)}</span>
            <span><strong>${item.label}</strong><small>${item.helper}</small></span>
          </button>
        `).join('');
        const cost = lotCost(lot);
        const sales = lotSalesTotal(lot.id);
        const live = lotLiveBirds(lot);
        const kg = lotCommercialKg(lot.id);
        const summary = [
          metricCard('Estado', lotStatus(lot), `${daysBetween(lot.entryDate)} dias de edad`),
          metricCard('Aves vivas', live, `${lotDeaths(lot.id)} muertes acumuladas`),
          metricCard('Consumo acumulado', `${number(lotFeedKg(lot.id), 1)} kg`, `FCA ${number(fcr(lot), 2)}`),
          metricCard('Costo acumulado', money(cost), `${money(live ? cost / live : 0)} por pollo`),
          metricCard('Costo / kg', money(kg ? cost / kg : 0), `${number(kg, 1)} kg comercializables`),
          metricCard('Utilidad lote', money(sales - cost), `Ventas ${money(sales)}`)
        ].join('');
        const panels = tabs.map((tab, index) => `<div class="tab-panel ${index === 0 ? 'is-active' : ''}" data-panel="${index}">${lotPanel(tab, lot, summary)}</div>`).join('');
        document.querySelector('#lotPanels').innerHTML = panels;
      }

      function lotOperationItems(lot) {
        const id = lot.id;
        return [
          { tab: 0, icon: 'dashboard', label: 'Resumen', helper: `${lotStatus(lot)} | ${daysBetween(lot.entryDate)} dias` },
          { tab: 1, icon: 'clipboard', label: 'Registro diario', helper: `${state.daily.filter((r) => r.lotId === id).length} registros` },
          { tab: 2, icon: 'feed', label: 'Alimentacion', helper: `${number(lotFeedKg(id), 1)} kg consumidos` },
          { tab: 3, icon: 'scale', label: 'Pesajes', helper: `${number(latestWeight(id), 2)} kg promedio` },
          { tab: 4, icon: 'alert', label: 'Mortalidad', helper: `${number(lotDeaths(id) / Number(lot.chicks || 1) * 100, 2)}% acumulada` },
          { tab: 5, icon: 'cost', label: 'Gastos', helper: money(lotExpenseCost(id)) },
          { tab: 6, icon: 'process', label: 'Procesamiento', helper: `${state.processing.filter((r) => r.lotId === id).length} registros` },
          { tab: 7, icon: 'sales', label: 'Ventas', helper: money(lotSalesTotal(id)) },
          { tab: 8, icon: 'reports', label: 'Rentabilidad', helper: money(lotSalesTotal(id) - lotCost(lot)) }
        ];
      }

      function lotPanel(tab, lot, summary) {
        const id = lot.id;
        if (tab === 'Resumen') return `<div class="grid three">${summary}</div>`;
        if (tab === 'Registro diario') return miniTable(['Fecha', 'Muertes', 'Alimento', 'Peso', 'Notas'], state.daily.filter((r) => r.lotId === id).map((r) => [dateLabel(r.date), r.deaths, `${number(r.feedKg)} kg`, r.avgWeight ? `${number(r.avgWeight, 2)} kg` : '-', r.notes || '-']));
        if (tab === 'Alimentacion') return miniTable(['Fecha', 'Tipo', 'Kg', 'Costo'], state.daily.filter((r) => r.lotId === id && Number(r.feedKg) > 0).map((r) => [dateLabel(r.date), r.feedType, number(r.feedKg), money(feedCostFor(r.feedType, r.feedKg))]));
        if (tab === 'Pesajes') return miniTable(['Fecha', 'Muestra', 'Peso prom.', 'Objetivo'], state.weights.filter((r) => r.lotId === id).map((r) => [dateLabel(r.date), r.sampleBirds, `${number(r.avgWeight, 2)} kg`, `${number(lot.targetWeight, 2)} kg`]));
        if (tab === 'Mortalidad') return miniTable(['Fecha', 'Cantidad', 'Causa', 'Observacion'], state.mortality.filter((r) => r.lotId === id).map((r) => [dateLabel(r.date), r.quantity, r.cause || '-', r.notes || '-']));
        if (tab === 'Gastos') return miniTable(['Fecha', 'Categoria', 'Concepto', 'Valor'], state.expenses.filter((r) => r.lotId === id || r.lotId === 'farm').map((r) => [dateLabel(r.date), r.category, r.concept, money(r.amount)]));
        if (tab === 'Procesamiento') return miniTable(['Fecha', 'Aves', 'Peso vivo', 'Peso canal', 'Rendimiento'], state.processing.filter((r) => r.lotId === id).map((r) => [dateLabel(r.date), r.birds, `${number(r.liveKg)} kg`, `${number(r.carcassKg)} kg`, `${number(r.carcassKg / r.liveKg * 100, 1)}%`]));
        if (tab === 'Ventas') return miniTable(['Fecha', 'Cliente', 'Canal', 'Gramos', 'Total'], state.sales.filter((r) => r.lotId === id).map((r) => [dateLabel(r.date), customerName(r.customerId), r.channel, `${number(saleGrams(r), 0)} g`, money(saleTotal(r))]));
        return `<div class="grid three">${metricCard('Ventas totales', money(lotSalesTotal(id)), 'Ingreso del lote')}${metricCard('Costo total', money(lotCost(lot)), 'Pollitos, alimento, gastos y proceso')}${metricCard('Margen bruto', `${number(lotSalesTotal(id) ? (lotSalesTotal(id) - lotCost(lot)) / lotSalesTotal(id) * 100 : 0, 1)}%`, money(lotSalesTotal(id) - lotCost(lot)))}</div>`;
      }

      function miniTable(headers, rows) {
        if (!rows.length) return '<div class="empty">Sin registros todavia.</div>';
        return `<div class="table-wrap"><table><thead><tr>${headers.map((h) => `<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.map((row) => `<tr>${row.map((cell) => `<td>${cell}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
      }

      function renderAlerts() {
        const alerts = [];
        state.lots.forEach((lot) => {
          const remaining = Number(lot.targetAge || 49) - daysBetween(lot.entryDate);
          const mortality = lotDeaths(lot.id) / Number(lot.chicks || 1) * 100;
          if (remaining <= 1 && remaining >= 0) alerts.push([`${lot.id} cumple edad objetivo manana o hoy`, 'warning']);
          if (mortality > state.settings.mortalityAlert) alerts.push([`Mortalidad de ${lot.id} supera la meta`, 'danger']);
          if (fcr(lot) > state.settings.acceptableFcr) alerts.push([`Conversion alimenticia de ${lot.id} requiere revision`, 'warning']);
        });
        state.feedInventory.forEach((feed) => {
          if (feed.kg <= feed.min) alerts.push([`Stock de ${feed.type} bajo`, 'warning']);
        });
        state.sales.filter((s) => s.paymentStatus !== 'Pagado').forEach((sale) => alerts.push([`${customerName(sale.customerId)} tiene pago pendiente`, 'danger']));
        const m = getMetrics();
        if (m.currentBirds + recommendedChicks() > state.planner.capacity) alerts.push(['El siguiente lote excederia la capacidad configurada', 'danger']);
        calendarTasks()
          .filter((task) => new Date(`${task.date}T00:00:00`) >= new Date(new Date().toDateString()))
          .toSorted((a, b) => a.date.localeCompare(b.date))
          .slice(0, 5)
          .forEach((task) => alerts.push([`${dateLabel(task.date)} | ${taskTime(task)} | ${task.title} - ${userName(task.assigneeId)}${task.lotId && task.lotId !== 'farm' ? ` (${task.lotId})` : ''}`, task.priority === 'Alta' ? 'danger' : task.priority === 'Media' ? 'warning' : 'info']));
        const levelLabel = { danger: 'Alta', warning: 'Media', info: 'Sugerencia' };
        const alertMarkup = alerts.map(([text, level]) => `<li><span>${text}</span><span class="chip ${level}">${levelLabel[level] || 'OK'}</span></li>`).join('') || '<li><span>Sin alertas criticas.</span><span class="chip">OK</span></li>';
        const dashboardAlertCount = document.querySelector('#alertCount');
        const dashboardAlerts = document.querySelector('#alertsList');
        if (dashboardAlertCount) dashboardAlertCount.textContent = alerts.length;
        document.querySelector('#alertBadge').textContent = alerts.length;
        if (dashboardAlerts) dashboardAlerts.innerHTML = alertMarkup;
        document.querySelector('#topAlertsList').innerHTML = alertMarkup;
      }

      function recommendedChicks() {
        return Math.ceil(Number(state.planner.commercialBirds || 0) / (1 - Number(state.planner.expectedMortality || 0) / 100));
      }

      function renderPlannerSummary() {
        const m = getMetrics();
        const chicks = recommendedChicks();
        const simultaneousLots = Math.ceil(Number(state.planner.cycleDays || 0) / Number(state.planner.intervalDays || 1));
        const requiredCapacity = chicks * simultaneousLots;
        const freeCapacity = Number(state.planner.capacity || 0) - m.currentBirds;
        const capacityPct = Math.min(100, m.currentBirds / state.planner.capacity * 100);
        const canReceiveNext = freeCapacity >= chicks;
        const fcrOpportunity = m.avgFcr > state.settings.acceptableFcr
          ? `Bajar FCA ${number(m.avgFcr - state.settings.acceptableFcr, 2)} puntos`
          : 'Mantener manejo actual';
        const mortalityOpportunity = m.avgMortality > state.settings.mortalityAlert
          ? `Reducir mortalidad ${number(m.avgMortality - state.settings.mortalityAlert, 2)}%`
          : 'Mortalidad dentro de meta';
        document.querySelector('#plannerSummary').textContent = `${chicks} pollitos por lote para producir ${state.planner.monthlyBirds} pollos/mes con entrada cada ${state.planner.intervalDays} dias.`;
        document.querySelector('#planInsights').innerHTML = [
          `<div class="plan-insight"><span>Lote sugerido</span><strong>${chicks} pollitos</strong><small>${state.planner.expectedMortality}% mortalidad esperada</small></div>`,
          `<div class="plan-insight"><span>Capacidad plan</span><strong>${requiredCapacity} aves</strong><small>${simultaneousLots} lotes simultaneos</small></div>`,
          `<div class="plan-insight"><span>Oportunidad</span><strong>${canReceiveNext ? fcrOpportunity : 'Liberar capacidad'}</strong><small>${canReceiveNext ? mortalityOpportunity : `Faltan ${Math.abs(freeCapacity - chicks)} cupos`}</small></div>`
        ].join('');
        document.querySelector('#capacityBar').style.setProperty('--value', `${capacityPct}%`);
        document.querySelector('#capacityText').textContent = `${m.currentBirds} de ${state.planner.capacity} aves en uso. ${canReceiveNext ? 'Puedes recibir el siguiente lote.' : 'No conviene recibir el siguiente lote todavia.'}`;
        const chip = document.querySelector('#planDecisionChip');
        chip.textContent = canReceiveNext ? 'Oportunidad' : 'Riesgo';
        chip.className = `chip ${canReceiveNext ? 'info' : 'danger'}`;
      }

