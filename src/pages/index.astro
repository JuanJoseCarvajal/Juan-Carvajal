      function customerName(id) {
        return state.customers.find((customer) => customer.id === id)?.name || id;
      }

      function saleInvoiceId(sale, index) {
        return sale.invoiceId || `FAC-2026-${String(index + 1).padStart(3, '0')}`;
      }

      function saleGrams(sale) {
        if (Number(sale.grams) > 0) return Number(sale.grams);
        if (Number(sale.kg) > 0) return Math.round(Number(sale.kg) * 453.592);
        return 0;
      }

      function salePriceGram(sale) {
        if (Number(sale.priceGram) > 0) return Number(sale.priceGram);
        if (Number(sale.priceKg) > 0) return Number(sale.priceKg) / 453.592;
        return productPrice(sale.product || currentProductCatalog()[0].name) / 453.592;
      }

      function saleTotal(sale) {
        if (sale.paymentStatus === 'Cancelada') return 0;
        return saleGrams(sale) * salePriceGram(sale);
      }

      function nextInvoiceId() {
        return `FAC-2026-${String((state.sales || []).length + 1).padStart(3, '0')}`;
      }

      function invoiceText(sale, index) {
        const customer = customerName(sale.customerId);
        return [
          `Factura: ${saleInvoiceId(sale, index)}`,
          `Fecha: ${dateLabel(sale.date)}`,
          `Cliente: ${customer}`,
          `Canal: ${sale.channel}`,
          `Lote: ${sale.lotId}`,
          `Producto: ${sale.product || currentProductCatalog()[0].name}`,
          `Cantidad: ${sale.quantity}`,
          `Gramos facturados: ${number(saleGrams(sale), 0)} g`,
          `Precio por gramo: ${money(salePriceGram(sale))}`,
          `Total: ${money(saleTotal(sale))}`,
          `Pago: ${sale.paymentStatus}`,
          `Metodo: ${sale.paymentMethod}`
        ].join('\n');
      }

      async function logoDataUrl() {
        const response = await fetch('/assets/logo-granja-galu.svg');
        const svg = await response.text();
        const image = new Image();
        image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
        await new Promise((resolve, reject) => {
          image.onload = resolve;
          image.onerror = reject;
        });
        const canvas = document.createElement('canvas');
        canvas.width = 240;
        canvas.height = 245;
        const context = canvas.getContext('2d');
        context.fillStyle = '#ffffff';
        context.fillRect(0, 0, canvas.width, canvas.height);
        context.drawImage(image, 0, 0, canvas.width, canvas.height);
        return canvas.toDataURL('image/png');
      }

      function userName(id) {
        return (state.users || []).find((user) => user.id === id)?.name || 'Sin encargado';
      }

      function taskTime(task) {
        if (task.allDay || (!task.startTime && !task.endTime)) return 'Todo el dia';
        return [task.startTime, task.endTime].filter(Boolean).join(' - ');
      }

      function recurrenceLabel(task) {
        return {
          none: 'Un dia',
          daily: 'Diaria',
          weekly: 'Semanal',
          monthly: 'Mensual'
        }[task.recurrence || 'none'] || 'Un dia';
      }

      function nextRecurringDate(date, recurrence) {
        const d = new Date(`${date}T00:00:00`);
        if (recurrence === 'monthly') d.setMonth(d.getMonth() + 1);
        else d.setDate(d.getDate() + (recurrence === 'weekly' ? 7 : 1));
        return d.toISOString().slice(0, 10);
      }

      function normalizeTask(task, index = 0) {
        return {
          id: task.id || `T-${index + 1}`,
          date: task.date,
          recurrence: task.recurrence || 'none',
          recurrenceEnd: task.recurrenceEnd || '',
          allDay: Boolean(task.allDay),
          startTime: task.startTime || '',
          endTime: task.endTime || '',
          assigneeId: task.assigneeId || state.users?.[0]?.id || '',
          status: task.status || 'Pendiente',
          type: task.type || 'Operacion',
          lotId: task.lotId || 'farm',
          priority: task.priority || 'Media',
          title: task.title || 'Tarea sin titulo',
          notes: task.notes || ''
        };
      }

      function expandCalendarTasks(tasks) {
        const todayIso = new Date().toISOString().slice(0, 10);
        const windowStart = addDays(todayIso, -35);
        const windowEnd = addDays(todayIso, 120);
        return tasks.flatMap((rawTask, index) => {
          const task = normalizeTask(rawTask, index);
          if (!task.date || task.recurrence === 'none') return [{ ...task, occurrenceId: `${task.id}-${task.date}` }];
          const end = task.recurrenceEnd || windowEnd;
          const occurrences = [];
          let current = task.date;
          while (current <= end && current <= windowEnd && occurrences.length < 90) {
            if (current >= windowStart) {
              occurrences.push({ ...task, date: current, isRecurring: true, occurrenceId: `${task.id}-${current}` });
            }
            current = nextRecurringDate(current, task.recurrence);
          }
          return occurrences;
        });
      }

