    <div class="quick-modal" id="plannerModal" role="dialog" aria-modal="true" aria-labelledby="plannerModalTitle">
      <div class="quick-dialog">
        <div class="quick-dialog-head">
          <div>
            <h2 id="plannerModalTitle">Planificador automatico</h2>
            <p>Actualiza frecuencia, capacidad y meta mensual solo despues de revisar el impacto.</p>
          </div>
          <button class="btn icon-btn" type="button" id="plannerClose" aria-label="Cerrar"><span class="icon" data-icon="close"></span></button>
        </div>
        <div class="quick-body" style="grid-template-columns: 1fr;">
          <form class="form-grid" id="plannerForm">
