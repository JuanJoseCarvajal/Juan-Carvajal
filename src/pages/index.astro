---
import { DataTable } from 'webcoreui/astro';
import 'webcoreui/styles';
import '@phosphor-icons/web/regular';

const today = new Date().toISOString().slice(0, 10);
const benchmarkHeadings = [
  { name: 'Indicador', sortable: true, filterable: true },
  { name: 'Meta sugerida', sortable: true, filterable: true },
  { name: 'Accion recomendada', filterable: true }
];
const benchmarkRows = [
  ['Conversion alimenticia', '<= 1.80', 'Excelente: mantener alimento y manejo actual'],
  ['Mortalidad acumulada', '<= 5%', 'Revisar temperatura, cama y manejo si supera la meta'],
  ['Ciclo productivo', '42 a 50 dias', 'Preparar procesamiento desde el dia 42'],
  ['Margen distribuidor', '25%', 'Precio = costo / (1 - margen)'],
  ['Margen venta directa', '40%', 'Priorizar clientes recurrentes y pago oportuno']
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Aplicacion web para gestionar lotes, costos, produccion, ventas y rentabilidad de pollo de engorde."
    />
    <title>Granja Pro | Pollo de Engorde</title>
    <style is:global>
      :root {
        color-scheme: light;
        --color-neutral-0: #ffffff;
        --color-neutral-50: #f7faf6;
        --color-neutral-100: #eef3ed;
        --color-neutral-200: #dce5da;
        --color-neutral-500: #62705f;
        --color-neutral-900: #172019;
        --color-green-600: #176a42;
        --color-green-800: #0f5132;
        --color-amber-700: #9a6400;
        --color-orange-700: #c46a17;
        --color-red-700: #b42318;
        --color-blue-700: #155f8f;
        --space-1: .25rem;
        --space-2: .5rem;
        --space-3: .75rem;
        --space-4: 1rem;
        --space-5: 1.25rem;
        --space-6: 1.5rem;
        --space-8: 2rem;
        --space-12: 3rem;
        --text-xs: .78rem;
        --text-sm: .86rem;
        --text-md: 1rem;
        --text-lg: 1.125rem;
        --text-xl: 1.5rem;
        --text-2xl: 1.9rem;
        --font-weight-strong: 800;
        --font-weight-heavy: 900;
        --radius-sm: 6px;
        --radius-md: 8px;
        --motion-fast: 160ms ease;
        --focus-ring: 0 0 0 3px color-mix(in srgb, var(--brand), transparent 70%);
        --bg: #f5f7f3;
        --surface: var(--color-neutral-0);
        --surface-2: var(--color-neutral-100);
        --ink: var(--color-neutral-900);
        --muted: var(--color-neutral-500);
        --line: var(--color-neutral-200);
        --brand: var(--color-green-600);
        --brand-2: var(--color-green-800);
        --accent: var(--color-orange-700);
        --info: var(--color-blue-700);
        --success: #1f7a4d;
        --warning: var(--color-amber-700);
        --danger: var(--color-red-700);
        --on-brand: #ffffff;
        --state-success-bg: #ecf4ee;
        --state-warning-bg: #fff2cf;
        --state-danger-bg: #ffe7e3;
        --state-info-bg: #e6f1fa;
        --shadow: 0 16px 36px rgba(23, 32, 25, 0.08);
        --radius: var(--radius-md);
        --sidebar-bg: #fbfcfa;
        --topbar-bg: rgba(245, 247, 243, .9);
        --nav-active-bg: #e8f2eb;
        --field-bg: #ffffff;
        --field-border: #ccd8ca;
        --table-card-bg: #ffffff;
        --table-panel-bg: #f7faf6;
        --table-wrap-bg: #ffffff;
        --table-line: #dce5da;
        --table-text: #172019;
        --table-muted: #62705f;
        --table-hover: #eef5ee;
        --table-control-bg: #ffffff;
        --table-control-border: #dce5da;
        --table-control-disabled: #8c9689;
      }

      body[data-theme="dark"] {
        color-scheme: dark;
        --bg: #090b0a;
        --surface: #101412;
        --surface-2: #171d19;
        --ink: #f5f5f5;
        --muted: #a3ada2;
        --line: #2b342d;
        --brand: #44b978;
        --brand-2: #8de0ae;
        --accent: #e4a24a;
        --info: #74b8e8;
        --success: #7bd8a3;
        --warning: #f1c36a;
        --danger: #ff8a7c;
        --on-brand: #07100b;
        --state-success-bg: #163425;
        --state-warning-bg: #3a2b0e;
        --state-danger-bg: #3a1714;
        --state-info-bg: #102b3d;
        --shadow: 0 18px 40px rgba(0, 0, 0, .28);
        --sidebar-bg: #080908;
        --topbar-bg: rgba(9, 11, 10, .88);
        --nav-active-bg: #18241d;
        --field-bg: #0d100f;
        --field-border: #303932;
        --table-card-bg: #080908;
        --table-panel-bg: #080908;
        --table-wrap-bg: #050605;
        --table-line: #303030;
        --table-text: #f5f5f5;
        --table-muted: #a3a3a3;
        --table-hover: #101110;
        --table-control-bg: #050605;
        --table-control-border: #303030;
        --table-control-disabled: #777;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.45;
        overflow: hidden;
        transition: background-color var(--motion-fast), color var(--motion-fast);
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      :focus-visible {
        outline: 0;
        box-shadow: var(--focus-ring);
      }

      ::selection {
        background: color-mix(in srgb, var(--brand), transparent 72%);
      }

      .app {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 17rem minmax(0, 1fr);
        transition: grid-template-columns var(--motion-fast);
      }

      body.is-sidebar-collapsed .app {
        grid-template-columns: 5.25rem minmax(0, 1fr);
      }

      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        border-right: 1px solid var(--line);
        background: var(--sidebar-bg);
        padding: var(--space-4);
        overflow-y: auto;
      }

      .sidebar-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2);
        border-bottom: 1px solid var(--line);
        padding-bottom: var(--space-4);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: .75rem;
        min-width: 0;
        padding: var(--space-2) .45rem 0;
      }

      .brand-mark {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--line);
        background: #32c5f4;
      }

      .brand-mark img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .brand strong {
        display: block;
        font-size: var(--text-md);
      }

      .brand span {
        color: var(--muted);
        font-size: var(--text-sm);
      }

      body.is-sidebar-collapsed .brand-copy,
      body.is-sidebar-collapsed .nav-group-title,
      body.is-sidebar-collapsed .nav-label {
        display: none;
      }

      body.is-sidebar-collapsed .sidebar {
        padding-inline: .75rem;
      }

      body.is-sidebar-collapsed .sidebar-top {
        justify-content: center;
      }

      body.is-sidebar-collapsed .brand {
        padding-inline: 0;
      }

      body.is-sidebar-collapsed .sidebar-toggle {
        position: absolute;
        left: 3.2rem;
        top: 1.85rem;
      }

      .nav {
        display: grid;
        gap: var(--space-4);
        margin-top: 1rem;
      }

      .nav-group {
        display: grid;
        gap: .2rem;
      }

      .nav-group-title {
        padding: 0 .65rem .25rem;
        color: var(--muted);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-heavy);
        text-transform: uppercase;
      }

      .nav button,
      .mobile-nav button {
        border: 0;
        background: transparent;
        color: var(--muted);
        text-align: left;
      }

      .nav button {
        display: flex;
        align-items: center;
        gap: .65rem;
        width: 100%;
        min-height: 2.55rem;
        padding: .6rem .65rem;
        border-radius: var(--radius);
        font-weight: 700;
      }

      body.is-sidebar-collapsed .nav button {
        justify-content: center;
        padding-inline: .55rem;
      }

      .nav-icon,
      .icon {
        display: inline-grid;
        place-items: center;
        flex: 0 0 auto;
        width: 1.25rem;
        height: 1.25rem;
        line-height: 1;
      }

      .nav-icon i,
      .icon i {
        display: inline-block;
        color: currentColor;
        font-size: 1.2rem;
        line-height: 1;
      }

      .nav button:hover,
      .nav button.is-active {
        background: var(--nav-active-bg);
        color: var(--brand-2);
      }

      .main {
        min-width: 0;
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 5;
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 4.25rem;
        padding: .8rem clamp(var(--space-4), 3vw, var(--space-8));
        border-bottom: 1px solid var(--line);
        background: var(--topbar-bg);
        backdrop-filter: blur(12px);
      }

      .topbar h1 {
        margin: 0;
        font-size: var(--text-2xl);
        letter-spacing: 0;
      }

      .topbar p {
        margin: .1rem 0 0;
        color: var(--muted);
        font-size: var(--text-md);
      }

      .page-titlebar {
        display: flex;
        align-items: flex-start;
        gap: var(--space-4);
        justify-content: space-between;
        min-width: min(100%, 34rem);
      }

      .page-toolbar {
        display: none;
        align-items: center;
        gap: var(--space-2);
        margin-top: .15rem;
      }

      .page-toolbar.is-active {
        display: flex;
      }

      .page-toolbar .inline-search.is-open input {
        min-width: 15rem;
      }

      .toolbar {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: .55rem;
        flex-wrap: wrap;
      }

      .search-shell {
        position: relative;
        width: min(26rem, 34vw);
      }

      .global-search {
        min-height: 2.5rem;
        padding-left: 2.2rem;
      }

      .search-shell .icon {
        position: absolute;
        left: .7rem;
        top: .62rem;
        color: var(--muted);
        pointer-events: none;
      }

      .search-results,
      .alerts-popover {
        position: absolute;
        z-index: 20;
        display: none;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .search-shell.is-open .search-results,
      .alerts-shell.is-open .alerts-popover {
        display: grid;
      }

      .search-results {
        inset: calc(100% + .45rem) 0 auto 0;
        padding: .4rem;
      }

      .search-results button {
        display: grid;
        gap: .15rem;
        width: 100%;
        border: 0;
        border-radius: var(--radius);
        background: transparent;
        color: var(--ink);
        padding: .65rem;
        text-align: left;
      }

      .search-results button:hover {
        background: var(--surface-2);
      }

      .search-results strong {
        display: flex;
        align-items: center;
        gap: .45rem;
      }

      .search-results small {
        color: var(--muted);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        min-height: 2.5rem;
        padding: .55rem .85rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--ink);
        font-weight: var(--font-weight-strong);
        text-decoration: none;
        white-space: nowrap;
      }

      .icon-btn {
        position: relative;
        width: 2.5rem;
        min-width: 2.5rem;
        padding: 0;
      }

      .btn.primary {
        border-color: var(--brand);
        background: var(--brand);
        color: var(--on-brand);
      }

      .btn.warning {
        border-color: color-mix(in srgb, var(--warning), transparent 55%);
        background: color-mix(in srgb, var(--warning), transparent 88%);
        color: var(--warning);
      }

      .theme-toggle {
        min-width: 2.5rem;
      }

      .alerts-shell {
        position: relative;
      }

      .alert-badge {
        position: absolute;
        top: -.35rem;
        right: -.35rem;
        display: grid;
        place-items: center;
        min-width: 1.15rem;
        height: 1.15rem;
        padding: 0 .25rem;
        border-radius: 999px;
        background: var(--danger);
        color: var(--surface);
        font-size: .68rem;
        font-weight: var(--font-weight-heavy);
      }

      .alerts-popover {
        right: 0;
        top: calc(100% + .5rem);
        width: min(24rem, calc(100vw - 2rem));
        padding: var(--space-3);
      }

      .alerts-popover h3 {
        margin: 0 0 var(--space-3);
      }

      .quick-modal {
        position: fixed;
        inset: 0;
        z-index: 30;
        display: none;
        align-items: center;
        justify-content: center;
        padding: var(--space-4);
        background: rgba(0, 0, 0, .52);
      }

      .quick-modal.is-open {
        display: flex;
      }

      .quick-dialog {
        width: min(58rem, 100%);
        max-height: min(44rem, calc(100vh - 2rem));
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .quick-dialog-head {
        position: sticky;
        top: 0;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-4);
        padding: var(--space-4);
        border-bottom: 1px solid var(--line);
        background: var(--surface);
      }

      .quick-dialog-head h2 {
        margin: 0;
      }

      .quick-dialog-head p {
        margin: .25rem 0 0;
        color: var(--muted);
      }

      .quick-section-intro {
        grid-column: 1 / -1;
        display: grid;
        gap: .25rem;
        padding: var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface-2);
      }

      .quick-section-intro strong {
        font-size: var(--text-lg);
      }

      .quick-section-intro p {
        margin: 0;
        color: var(--muted);
      }

      .quick-body {
        display: grid;
        grid-template-columns: 12rem minmax(0, 1fr);
        gap: var(--space-4);
        padding: var(--space-4);
      }

      .quick-actions {
        display: grid;
        align-content: start;
        gap: .35rem;
      }

      .quick-actions button {
        display: flex;
        align-items: center;
        gap: .55rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--ink);
        padding: .7rem;
        font-weight: var(--font-weight-strong);
        text-align: left;
      }

      .quick-actions button.is-active,
      .quick-actions button:hover {
        border-color: var(--brand);
        background: var(--nav-active-bg);
        color: var(--brand-2);
      }

      .page-actionbar {
        display: flex;
        justify-content: flex-end;
        gap: var(--space-2);
        margin-bottom: var(--space-4);
      }

      .decision-banner {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(10rem, .55fr));
        gap: var(--space-4);
        align-items: stretch;
        margin-bottom: var(--space-4);
        padding: var(--space-4);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .decision-copy {
        display: grid;
        align-content: center;
        gap: var(--space-2);
      }

      .decision-copy h2,
      .decision-copy p {
        margin: 0;
      }

      .decision-copy p {
        color: var(--muted);
      }

      .decision-card {
        display: grid;
        align-content: center;
        gap: var(--space-1);
        min-height: 6.75rem;
        padding: var(--space-4);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface-2);
      }

      .decision-card span {
        color: var(--muted);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-strong);
      }

      .decision-card strong {
        font-size: var(--text-xl);
        line-height: 1.1;
      }

      .suggestion-alert {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: var(--space-3);
        align-items: center;
        margin-bottom: var(--space-4);
        padding: var(--space-4);
        border: 1px solid color-mix(in srgb, var(--info), transparent 62%);
        border-radius: var(--radius);
        background: var(--state-info-bg);
      }

      .suggestion-alert.is-risk {
        border-color: color-mix(in srgb, var(--warning), transparent 48%);
        background: var(--state-warning-bg);
      }

      .suggestion-alert h2,
      .suggestion-alert p {
        margin: 0;
      }

      .suggestion-alert p {
        color: var(--muted);
      }

      .calendar-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-4);
        height: 100%;
        min-height: 0;
      }

      .calendar-panel {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: var(--space-3);
        height: 100%;
        min-height: 0;
      }

      .calendar-panel.card-pad {
        padding: var(--space-3);
      }

      .calendar-panel .section-head {
        align-items: center;
        margin-bottom: 0;
      }

      .calendar-panel .section-head h2 {
        font-size: var(--text-xl);
      }

      .calendar-panel .section-head p {
        font-size: var(--text-sm);
      }

      .calendar-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-2);
      }

      .view-switch {
        display: inline-flex;
        gap: .25rem;
        padding: .25rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface-2);
      }

      .view-switch button {
        min-height: 2.25rem;
        border: 0;
        border-radius: var(--radius-sm);
        background: transparent;
        color: var(--muted);
        padding: .35rem .65rem;
        font-weight: var(--font-weight-heavy);
      }

      .view-switch button.is-active {
        background: var(--surface);
        color: var(--ink);
        box-shadow: var(--shadow);
      }

      .calendar-grid {
        display: grid;
        gap: 1px;
        min-height: 0;
        overflow: visible;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--line);
      }

      .calendar-grid.month {
        grid-template-columns: repeat(7, minmax(0, 1fr));
        grid-template-rows: repeat(6, minmax(0, 1fr));
      }

      .calendar-grid.week {
        grid-template-columns: repeat(7, minmax(0, 1fr));
      }

      .calendar-grid.day {
        grid-template-columns: minmax(0, 1fr);
      }

      .calendar-day {
        display: grid;
        align-content: start;
        gap: .55rem;
        min-height: 8.6rem;
        min-width: 0;
        overflow: visible;
        padding: .75rem;
        background: var(--surface);
      }

      .calendar-grid.month .calendar-day {
        gap: .28rem;
        min-height: 0;
        padding: .42rem;
      }

      .calendar-day.is-today {
        outline: 2px solid color-mix(in srgb, var(--brand), transparent 35%);
        outline-offset: -2px;
      }

      .calendar-day.is-muted {
        background: var(--surface-2);
        color: var(--muted);
      }

      .calendar-day-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-heavy);
      }

      .calendar-task-list {
        display: grid;
        gap: .3rem;
        min-height: 0;
      }

      .calendar-task {
        position: relative;
        display: grid;
        gap: .1rem;
        min-width: 0;
        padding: .45rem .55rem;
        border-left: 3px solid var(--brand);
        border-radius: var(--radius-sm);
        background: var(--surface-2);
        font-size: var(--text-xs);
        cursor: help;
      }

      .calendar-grid.month .calendar-task {
        gap: 0;
        padding: .22rem .34rem;
        border-left-width: 2px;
        font-size: .68rem;
      }

      .calendar-task.warning {
        border-left-color: var(--warning);
      }

      .calendar-task.danger {
        border-left-color: var(--danger);
      }

      .calendar-task strong {
        font-size: var(--text-xs);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .calendar-grid.month .calendar-task strong {
        font-size: .68rem;
      }

      .calendar-task span {
        overflow: hidden;
        color: var(--muted);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .calendar-task[data-tooltip]:hover::after,
      .calendar-task[data-tooltip]:focus-visible::after {
        content: attr(data-tooltip);
        position: absolute;
        z-index: 40;
        left: .35rem;
        bottom: calc(100% + .4rem);
        width: min(18rem, 72vw);
        padding: .65rem .75rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--ink);
        box-shadow: var(--shadow);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-strong);
        line-height: 1.35;
        white-space: pre-line;
        pointer-events: none;
      }

      .planner-sidebar {
        display: grid;
        align-content: start;
        gap: var(--space-4);
      }

      .calendar-chart-grid {
        display: grid;
        gap: var(--space-3);
      }

      .info-content {
        display: grid;
        gap: var(--space-4);
      }

      .info-content section {
        display: grid;
        gap: var(--space-2);
      }

      .info-content h3,
      .info-content p {
        margin: 0;
      }

      .info-content ul {
        display: grid;
        gap: .55rem;
        margin: 0;
        padding-left: 1.1rem;
        color: var(--muted);
      }

      .planner-impact {
        display: none;
        gap: var(--space-3);
        margin-top: var(--space-4);
        padding: var(--space-4);
        border: 1px solid color-mix(in srgb, var(--warning), transparent 55%);
        border-radius: var(--radius);
        background: color-mix(in srgb, var(--warning), transparent 90%);
      }

      .planner-impact.is-active {
        display: grid;
      }

      .planner-impact h3,
      .planner-impact p {
        margin: 0;
      }

      .planner-impact p {
        color: var(--muted);
      }

      .planner-impact-actions {
        display: flex;
        gap: var(--space-2);
        justify-content: flex-end;
        flex-wrap: wrap;
      }

      .content {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        padding: clamp(var(--space-4), 3vw, var(--space-8));
      }

      .section {
        display: none;
      }

      .section.is-active {
        display: block;
        height: 100%;
        overflow: auto;
      }

      #procesamiento.is-active {
        min-height: calc(100vh - 4.25rem - clamp(var(--space-4), 3vw, var(--space-8)) * 2);
        display: grid;
        grid-template-rows: auto minmax(26rem, 1fr);
        gap: var(--space-4);
      }

      #calendario.is-active {
        display: grid;
        height: 100%;
        min-height: calc(100vh - 4.25rem - clamp(var(--space-4), 3vw, var(--space-8)) * 2);
        overflow: hidden;
      }

      .grid {
        display: grid;
        gap: var(--space-4);
        min-height: 0;
      }

      .metrics {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .dashboard-top {
        display: grid;
        grid-template-columns: minmax(0, .95fr) minmax(24rem, 1.05fr);
        gap: var(--space-4);
        align-items: stretch;
      }

      .dashboard-kpis {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-4);
      }

      .dashboard-insights {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-4);
        margin-top: var(--space-4);
      }

      .dashboard-card {
        display: grid;
        align-content: space-between;
        gap: var(--space-4);
        min-height: 18rem;
        padding: var(--space-4);
      }

      .metric-action,
      .insight-action {
        cursor: pointer;
        text-align: left;
        transition: border-color var(--motion-fast), box-shadow var(--motion-fast), transform var(--motion-fast);
      }

      .metric-action:hover,
      .insight-action:hover {
        border-color: color-mix(in srgb, var(--brand), var(--line) 35%);
        box-shadow: var(--shadow-lg);
        transform: translateY(-1px);
      }

      .metric-action .metric-top,
      .insight-title {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-3);
      }

      .metric-action .icon,
      .insight-title .icon {
        color: var(--brand);
      }

      .metric-action strong {
        line-height: 1.08;
      }

      .metric-action footer,
      .insight-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2);
        margin-top: var(--space-3);
        color: var(--muted);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-heavy);
      }

      .insight-action {
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
      }

      .dashboard-chart {
        display: grid;
        gap: var(--space-3);
      }

      .chart-row {
        display: grid;
        gap: .45rem;
      }

      .chart-row-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2);
        color: var(--muted);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-strong);
      }

      .chart-row strong {
        color: var(--ink);
      }

      .comparison-bars {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-3);
      }

      .comparison-item {
        display: grid;
        gap: .5rem;
        padding: var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface-2);
      }

      .comparison-item span {
        color: var(--muted);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-heavy);
        text-transform: uppercase;
      }

      .comparison-item strong {
        font-size: var(--text-lg);
      }

      .mini-donut {
        --donut-value: 0%;
        --donut-color: var(--brand);
        display: grid;
        place-items: center;
        width: 8.5rem;
        aspect-ratio: 1;
        border-radius: 50%;
        background: conic-gradient(var(--donut-color) var(--donut-value), var(--surface-2) 0);
        box-shadow: inset 0 0 0 1px var(--line);
      }

      .mini-donut span {
        display: grid;
        place-items: center;
        width: 5.6rem;
        aspect-ratio: 1;
        border-radius: 50%;
        background: var(--surface);
        color: var(--ink);
        font-size: var(--text-lg);
        font-weight: var(--font-weight-heavy);
      }

      .donut-row {
        display: flex;
        align-items: center;
        gap: var(--space-4);
      }

      .insight-copy {
        color: var(--muted);
        line-height: 1.45;
      }

      .production-plan-card {
        display: grid;
        align-content: space-between;
        gap: var(--space-4);
        min-height: 100%;
      }

      .processing-summary-panel {
        display: none;
      }

      .processing-summary-panel.is-open {
        display: block;
      }

      .processing-records-card {
        display: flex;
        flex-direction: column;
        min-height: max(30rem, calc(100vh - 8rem));
      }

      .processing-records-card .table-wrap {
        flex: 1;
        min-height: 0;
        max-height: none;
      }

      .plan-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        flex-wrap: wrap;
      }

      .plan-insights {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-3);
      }

      .plan-insight {
        display: grid;
        gap: var(--space-1);
        padding: var(--space-3);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface-2);
      }

      .plan-insight span {
        color: var(--muted);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-heavy);
        text-transform: uppercase;
      }

      .plan-insight strong {
        font-size: var(--text-lg);
      }

      .two {
        grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr);
      }

      .single-content-grid {
        grid-template-columns: minmax(0, 1fr);
        height: 100%;
      }

      .three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .card {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .card-pad {
        padding: var(--space-4);
      }

      .metric {
        min-height: 8rem;
        padding: 1rem;
      }

      .metric span {
        color: var(--muted);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-strong);
      }

      .metric strong {
        display: block;
        margin-top: .55rem;
        font-size: var(--text-xl);
        line-height: 1;
      }

      .metric small {
        display: block;
        margin-top: .55rem;
        color: var(--muted);
      }

      .section-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-4);
        margin: 0 0 1rem;
      }

      .component-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-2);
        min-width: min(100%, 19rem);
      }

      .record-form-modal .quick-dialog {
        width: min(48rem, 100%);
      }

      .record-form-modal .card {
        border: 0;
        box-shadow: none;
        background: transparent;
      }

      .record-form-modal .card-pad {
        padding: 0;
        border-bottom: 0;
        background: transparent;
      }

      .record-form-modal h2 {
        display: none;
      }

      .inline-search {
        display: grid;
        grid-template-columns: 0fr;
        align-items: center;
        transition: grid-template-columns var(--motion-fast);
      }

      .inline-search.is-open {
        grid-template-columns: 1fr;
      }

      .inline-search input {
        min-width: 0;
        width: 100%;
        opacity: 0;
        padding-inline: 0;
        border-width: 0;
        transition: opacity var(--motion-fast), padding var(--motion-fast), border-width var(--motion-fast);
      }

      .inline-search.is-open input {
        min-width: 13rem;
        opacity: 1;
        padding: .58rem .7rem;
        border-width: 1px;
      }

      .section-head h2,
      .card h2,
      .card h3 {
        margin: 0;
        letter-spacing: 0;
      }

      .component-title {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        column-gap: .7rem;
      }

      .component-title p {
        grid-column: 2;
      }

      .component-title-icon {
        grid-row: 1 / span 2;
        width: 2.4rem;
        height: 2.4rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--brand);
      }

      .section-head p,
      .card p {
        margin: .25rem 0 0;
        color: var(--muted);
      }

      .card:has(.table-wrap) {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
        border-color: var(--table-line);
        background: var(--table-card-bg);
        color: var(--table-text);
      }

      .card:has(.table-wrap) .card-pad {
        border-bottom: 1px solid var(--table-line);
        background: var(--table-panel-bg);
      }

      .card:has(.table-wrap) .card-pad h2,
      .card:has(.table-wrap) .card-pad h3,
      .card:has(.table-wrap) .section-head h2 {
        color: var(--table-text);
      }

      .card:has(.table-wrap) .card-pad p,
      .card:has(.table-wrap) .section-head p {
        color: var(--table-muted);
      }

      .card:has(.table-wrap) .table-wrap {
        flex: 1;
        min-height: 14rem;
        max-height: min(34rem, calc(100vh - 14rem));
        margin: 0;
        padding: 24px;
        overflow: auto;
        background: var(--table-wrap-bg);
      }

      .card:has(.table-wrap) thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--table-wrap-bg);
      }

      .processing-records-card.processing-records-card .table-wrap {
        max-height: none;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
      }

      th,
      td {
        padding: .62rem .75rem;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: middle;
        font-size: 16px;
      }

      th {
        color: var(--muted);
        background: var(--surface-2);
        font-size: 12px;
        letter-spacing: .02rem;
        text-transform: uppercase;
      }

      tr:last-child td {
        border-bottom: 0;
      }

      .card:has(.table-wrap) th,
      .card:has(.table-wrap) td {
        border-bottom-color: var(--table-line);
        color: var(--table-text);
        font-size: 16px;
        line-height: 1.2;
      }

      .card:has(.table-wrap) th {
        background: transparent;
        color: var(--table-text);
        font-size: 12px;
        font-weight: var(--font-weight-heavy);
        letter-spacing: .02rem;
        text-transform: uppercase;
      }

      .card:has(.table-wrap) tr:hover td {
        background: var(--table-hover);
      }

      .smart-table-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-2);
        margin-left: auto;
      }

      .card:has(.table-wrap) .section-head {
        align-items: center;
      }

      .smart-table-toolbar .inline-search {
        max-width: min(17rem, 48vw);
      }

      .smart-table-search-panel {
        display: none;
        margin-top: .4rem;
        color: var(--table-muted);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-strong);
      }

      .inline-search.is-open .smart-table-search-panel {
        display: block;
      }

      .smart-table-toolbar .inline-search input {
        border-color: var(--table-control-border);
        background-color: var(--table-control-bg);
        color: var(--table-text);
      }

      .card:has(.table-wrap) .component-actions .inline-search input {
        border-color: var(--table-control-border);
        background-color: var(--table-control-bg);
        color: var(--table-text);
      }

      .card:has(.table-wrap) .component-actions .inline-search input::placeholder {
        color: var(--table-muted);
      }

      .card:has(.table-wrap) .component-actions .btn {
        min-height: 2.5rem;
        width: 2.5rem;
        min-width: 2.5rem;
        padding: 0;
        border-color: var(--table-control-border);
        background: var(--table-control-bg);
        color: var(--table-text);
      }

      .card:has(.table-wrap) .component-actions .btn:hover,
      .card:has(.table-wrap) .component-actions .btn[aria-expanded="true"] {
        border-color: color-mix(in srgb, var(--table-text), transparent 62%);
        background: var(--table-hover);
        color: var(--table-text);
      }

      .smart-table-toolbar .btn {
        min-height: 2.5rem;
        width: 2.5rem;
        min-width: 2.5rem;
        padding: 0;
        border-color: var(--table-control-border);
        background: var(--table-control-bg);
        color: var(--table-text);
      }

      .smart-table-toolbar .btn:hover,
      .smart-table-toolbar .btn[aria-expanded="true"] {
        border-color: color-mix(in srgb, var(--table-text), transparent 62%);
        background: var(--table-hover);
        color: var(--table-text);
      }

      .smart-table-toolbar .icon {
        color: currentColor;
      }

      .smart-table-toolbar .inline-search input::placeholder {
        color: var(--table-muted);
      }

      .smart-table-toolbar .inline-search.is-open input {
        min-width: 12rem;
      }

      .table-wrap > .smart-table-toolbar {
        margin: 0 0 var(--space-3);
      }

      .smart-table-meta {
        color: var(--table-muted);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-strong);
        white-space: nowrap;
      }

      .smart-table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        padding: 0 24px 24px;
        border-top: 0;
        background: var(--table-wrap-bg);
      }

      .smart-table-pages {
        display: flex;
        justify-content: flex-end;
        gap: .7rem;
      }

      .smart-table-pages button,
      .sort-button {
        border: 1px solid var(--table-control-border);
        border-radius: var(--radius);
        background: var(--table-control-bg);
        color: var(--table-text);
        font-weight: var(--font-weight-heavy);
      }

      .smart-table-pages button {
        min-width: 2.5rem;
        min-height: 2.5rem;
        padding: .55rem .85rem;
        font-size: var(--text-sm);
      }

      .smart-table-pages button:disabled {
        color: var(--table-control-disabled);
        cursor: not-allowed;
      }

      .smart-table-pages button:not(:disabled):hover {
        border-color: color-mix(in srgb, var(--table-text), transparent 62%);
        background: var(--table-hover);
      }

      .sort-button {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        width: 100%;
        padding: .2rem 0;
        border: 0;
        background: transparent;
        color: inherit;
        text-align: left;
      }

      .sort-button::after {
        content: "<>";
        color: var(--muted);
        font-size: var(--text-xs);
      }

      .sort-button[data-dir="asc"]::after {
        content: "^";
        color: var(--table-text);
      }

      .sort-button[data-dir="desc"]::after {
        content: "v";
        color: var(--table-text);
      }

      tr[data-smart-hidden="true"] {
        display: none;
      }

      .webcore-reference {
        --w-color-primary-70: var(--table-wrap-bg);
        --w-color-primary-60: var(--table-hover);
        --w-color-primary-50: var(--table-line);
        --w-color-primary-20: var(--table-muted);
        padding: 24px;
        border: 1px solid var(--table-line);
        border-radius: var(--radius);
        background: var(--table-wrap-bg);
        color: var(--table-text);
      }

      .webcore-reference table {
        min-width: 640px;
      }

      .webcore-reference th,
      .webcore-reference td {
        border-bottom: 1px solid var(--table-line);
        color: var(--table-text);
        font-size: 16px;
        line-height: 1.2;
      }

      .webcore-reference th,
      .webcore-reference th button {
        color: var(--table-text);
        font-size: 12px;
        font-weight: var(--font-weight-heavy);
        letter-spacing: .02rem;
        text-transform: uppercase;
      }

      .webcore-reference button {
        border-color: var(--table-control-border);
        background: var(--table-control-bg);
        color: var(--table-text);
      }

      .webcore-reference input {
        border-color: var(--table-control-border);
        background: var(--table-control-bg);
        color: var(--table-text);
      }

      .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 1.65rem;
        padding: .2rem .55rem;
        border-radius: 999px;
        background: var(--state-success-bg);
        color: var(--brand-2);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-heavy);
        white-space: nowrap;
      }

      .chip.warning {
        background: var(--state-warning-bg);
        color: var(--warning);
      }

      .chip.danger {
        background: var(--state-danger-bg);
        color: var(--danger);
      }

      .chip.info {
        background: var(--state-info-bg);
        color: var(--info);
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-3);
      }

      label {
        display: grid;
        gap: .3rem;
        color: var(--muted);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-strong);
      }

      label.is-disabled {
        opacity: .62;
      }

      input,
      select,
      textarea {
        width: 100%;
        min-height: 2.65rem;
        border: 1px solid var(--field-border);
        border-radius: var(--radius);
        background: var(--field-bg);
        color: var(--ink);
        padding: .58rem .7rem;
        transition: border-color var(--motion-fast), box-shadow var(--motion-fast), background-color var(--motion-fast);
      }

      .checkbox-field {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-height: 2.65rem;
        padding: .58rem .7rem;
        border: 1px solid var(--field-border);
        border-radius: var(--radius);
        background: var(--field-bg);
        color: var(--ink);
      }

      .checkbox-field input {
        width: auto;
        min-height: 0;
        accent-color: var(--brand);
      }

      .table-input {
        min-height: 2.25rem;
        max-width: 100%;
      }

      .table-input.is-number {
        max-width: 9rem;
      }

      tfoot td {
        border-top: 1px solid var(--table-line);
        color: var(--table-text);
        font-weight: var(--font-weight-heavy);
      }

      .row-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-2);
      }

      .row-actions .btn {
        flex: 0 0 auto;
      }

      .sales-table th,
      .sales-table td {
        padding: .48rem .55rem;
        font-size: 16px;
        line-height: 1.15;
      }

      .sales-table th {
        font-size: 12px;
      }

      .sales-table .chip {
        min-height: 1.35rem;
        padding: .1rem .45rem;
      }

      .invoice-menu {
        position: relative;
        display: flex;
        justify-content: flex-end;
      }

      .action-menu {
        position: absolute;
        right: 0;
        top: calc(100% + .35rem);
        z-index: 24;
        display: none;
        min-width: 11rem;
        padding: .35rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .invoice-menu.is-open .action-menu {
        display: grid;
        gap: .15rem;
      }

      .action-menu button {
        justify-content: flex-start;
        width: 100%;
        border: 0;
        background: transparent;
        padding: .5rem .6rem;
        color: var(--ink);
      }

      .action-menu button:hover {
        background: var(--surface-2);
      }

      input:hover,
      select:hover,
      textarea:hover {
        border-color: color-mix(in srgb, var(--brand), var(--field-border) 62%);
      }

      textarea {
        min-height: 5.5rem;
        resize: vertical;
      }

      .span-2 {
        grid-column: span 2;
      }

      .tabs {
        display: flex;
        gap: .4rem;
        overflow-x: auto;
        padding: .5rem;
        border-bottom: 1px solid var(--line);
      }

      .tabs button {
        flex: 0 0 auto;
        min-height: 2.25rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--muted);
        padding: .45rem .75rem;
        font-weight: var(--font-weight-strong);
      }

      .tabs button.is-active {
        border-color: var(--brand);
        background: var(--brand);
        color: var(--on-brand);
      }

      .lot-operation-nav {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-3);
        padding: 0 var(--space-4) var(--space-4);
      }

      .lot-operation-nav button {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: var(--space-2);
        align-items: start;
        min-height: 5.4rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface-2);
        color: var(--ink);
        padding: var(--space-3);
        text-align: left;
      }

      .lot-operation-nav button:hover,
      .lot-operation-nav button.is-active {
        border-color: var(--brand);
        background: var(--nav-active-bg);
      }

      .lot-operation-nav strong {
        display: block;
        margin-bottom: .15rem;
      }

      .lot-operation-nav small {
        color: var(--muted);
      }

      .tab-panel {
        display: none;
        padding: 1rem;
      }

      .tab-panel.is-active {
        display: block;
      }

      .alert-list,
      .timeline,
      .mini-list {
        display: grid;
        gap: .75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .alert-list li,
      .mini-list li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .8rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .timeline-item {
        display: grid;
        gap: .45rem;
      }

      .bar {
        display: grid;
        grid-template-columns: 18% 28% 30% 12% 12%;
        overflow: hidden;
        height: 1.65rem;
        border-radius: var(--radius);
        background: var(--surface-2);
      }

      .bar span {
        display: block;
      }

      .bar span:nth-child(1) { background: #b9d8bd; }
      .bar span:nth-child(2) { background: #7fb88b; }
      .bar span:nth-child(3) { background: #36895b; }
      .bar span:nth-child(4) { background: #d99442; }
      .bar span:nth-child(5) { background: #246c9b; }

      .bar-labels {
        display: flex;
        justify-content: space-between;
        gap: .5rem;
        color: var(--muted);
        font-size: var(--text-xs);
      }

      .stat-line {
        display: grid;
        gap: .45rem;
      }

      .progress {
        height: .65rem;
        overflow: hidden;
        border-radius: 999px;
        background: var(--surface-2);
      }

      .progress span {
        display: block;
        height: 100%;
        width: var(--value);
        max-width: 100%;
        background: var(--brand);
      }

      .mobile-nav {
        display: none;
      }

      .fab {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 10;
        display: none;
      }

      .fab-panel {
        position: absolute;
        right: 0;
        bottom: 3.25rem;
        display: none;
        width: 13rem;
        padding: .45rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .fab.is-open .fab-panel {
        display: grid;
        gap: .25rem;
      }

      .fab-panel button {
        border: 0;
        border-radius: var(--radius);
        background: transparent;
        padding: .65rem;
        text-align: left;
        font-weight: var(--font-weight-strong);
      }

      .calculator-result {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
      }

      .result-box {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface-2);
        padding: .85rem;
      }

      .result-box span {
        color: var(--muted);
        font-size: var(--text-sm);
        font-weight: var(--font-weight-strong);
      }

      .result-box strong {
        display: block;
        margin-top: .35rem;
        font-size: var(--text-lg);
      }

      .empty {
        padding: 2rem;
        color: var(--muted);
        text-align: center;
      }

      .design-system-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-4);
        margin-top: var(--space-4);
      }

      .token-swatch {
        display: grid;
        gap: var(--space-2);
        min-height: 6.5rem;
        padding: var(--space-4);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface-2);
      }

      .token-swatch::before {
        content: "";
        display: block;
        width: 100%;
        height: 1.35rem;
        border-radius: var(--radius-sm);
        background: var(--swatch);
      }

      .token-swatch strong {
        font-size: var(--text-sm);
      }

      .token-swatch span {
        color: var(--muted);
        font-size: var(--text-xs);
      }

      @media (max-width: 1120px) {
        .dashboard-top {
          grid-template-columns: 1fr;
        }

        .metrics,
        .three,
        .dashboard-insights,
        .design-system-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .two {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 800px) {
        .app {
          display: block;
        }

        .sidebar {
          display: none;
        }

        .mobile-nav {
          display: block;
          width: 100%;
        }

        .mobile-nav button {
          width: 100%;
          min-height: 2.6rem;
          border: 1px solid var(--line);
          border-radius: var(--radius);
          background: var(--surface);
          padding: .55rem .75rem;
          font-weight: 900;
        }

        .mobile-menu {
          display: none;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: .4rem;
          margin-top: .5rem;
        }

        .mobile-nav.is-open .mobile-menu {
          display: grid;
        }

        .mobile-menu button {
          font-size: .85rem;
        }

        .topbar {
          position: static;
          align-items: flex-start;
          flex-direction: column;
        }

        .page-titlebar {
          width: 100%;
          flex-direction: column;
        }

        .page-toolbar {
          width: 100%;
          justify-content: flex-end;
        }

        .page-toolbar .inline-search.is-open input {
          min-width: 0;
        }

        .toolbar {
          width: 100%;
        }

        .toolbar .btn {
          flex: 1 1 auto;
        }

        .topbar-actions,
        .search-shell {
          width: 100%;
        }

        .topbar-actions {
          align-items: stretch;
        }

        .topbar-actions .btn:not(.icon-btn) {
          flex: 1 1 auto;
        }

        .quick-body {
          grid-template-columns: 1fr;
        }

        .quick-actions {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .decision-banner {
          grid-template-columns: 1fr;
        }

        .suggestion-alert {
          grid-template-columns: 1fr;
        }

        .calendar-shell {
          grid-template-columns: 1fr;
        }

        .calendar-grid.month,
        .calendar-grid.week {
          grid-template-columns: repeat(7, minmax(0, 1fr));
        }

        .calendar-grid.month {
          grid-template-rows: repeat(6, minmax(0, 1fr));
        }

        .calendar-grid.month .calendar-day {
          padding: .25rem;
        }

        .calendar-grid.month .calendar-day-head,
        .calendar-grid.month .calendar-task,
        .calendar-grid.month .calendar-task strong {
          font-size: .58rem;
        }

        .page-actionbar {
          justify-content: stretch;
        }

        .page-actionbar .btn {
          flex: 1;
        }

        .component-actions {
          width: 100%;
          min-width: 0;
        }

        .inline-search {
          flex: 1;
        }

        .inline-search.is-open input {
          min-width: 0;
        }

        .smart-table-footer {
          align-items: stretch;
          flex-direction: column;
        }

        .smart-table-pages {
          width: 100%;
        }

        .smart-table-pages button {
          flex: 0 0 auto;
        }

        .metrics,
        .three,
        .dashboard-kpis,
        .dashboard-insights,
        .comparison-bars,
        .lot-operation-nav,
        .plan-insights,
        .form-grid,
        .design-system-grid,
        .calculator-result {
          grid-template-columns: 1fr;
        }

        .span-2 {
          grid-column: auto;
        }

        .donut-row {
          align-items: flex-start;
          flex-direction: column;
        }

        .fab {
          display: block;
        }

        .content {
          padding-bottom: 5.5rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="app">
      <aside class="sidebar">
        <div class="sidebar-top">
          <div class="brand">
            <div class="brand-mark"><img src="/assets/logo-granja-galu.svg" alt="Granja GALU" /></div>
            <div class="brand-copy">
              <strong>Granja Pro</strong>
              <span>Pollo de engorde</span>
            </div>
          </div>
          <button class="btn icon-btn sidebar-toggle" type="button" id="sidebarToggle" aria-label="Contraer menu" aria-pressed="false"></button>
        </div>
        <nav class="nav" id="desktopNav" aria-label="Navegacion principal"></nav>
      </aside>

      <main class="main">
        <header class="topbar">
          <div class="page-titlebar" aria-label="Granja GALU">
            <div class="brand compact-brand">
              <div class="brand-mark"><img src="/assets/logo-granja-galu.svg" alt="Granja GALU" /></div>
              <div class="brand-copy">
                <strong>Granja GALU</strong>
                <span>Operacion avicola</span>
              </div>
            </div>
          </div>
          <div class="toolbar">
            <div class="mobile-nav" id="mobileNav">
              <button type="button" id="menuToggle">Menu</button>
              <div class="mobile-menu" id="mobileMenu"></div>
            </div>
            <div class="topbar-actions">
              <div class="search-shell" id="searchShell">
                <span class="icon" data-icon="search"></span>
                <input class="global-search" id="globalSearch" type="search" placeholder="Buscar lote, cliente, venta o modulo" aria-label="Busqueda global" />
                <div class="search-results" id="searchResults"></div>
              </div>
              <button class="btn primary" type="button" id="quickRegisterButton">+ Registrar</button>
              <div class="alerts-shell" id="alertsShell">
                <button class="btn icon-btn" type="button" id="alertsButton" aria-label="Ver alertas" aria-expanded="false">
                  <span class="icon" data-icon="bell"></span>
                  <span class="alert-badge" id="alertBadge">0</span>
                </button>
                <div class="alerts-popover" id="alertsPopover">
                  <h3>Alertas</h3>
                  <ul class="alert-list" id="topAlertsList"></ul>
                </div>
              </div>
              <button class="btn icon-btn theme-toggle" type="button" id="themeToggle" aria-label="Cambiar tema" aria-pressed="false"></button>
              <button class="btn icon-btn" type="button" data-jump="configuracion" aria-label="Configuracion"><span class="icon" data-icon="settings"></span></button>
              <button class="btn" type="button" id="seedButton">Restaurar demo</button>
            </div>
          </div>
        </header>

        <div class="content">
          <section class="section is-active" id="dashboard" data-title="Dashboard" data-subtitle="Vision rapida y accionable de toda la granja.">
            <div class="dashboard-top">
              <div class="dashboard-kpis" id="dashboardMetrics"></div>
              <article class="card card-pad production-plan-card">
                <div class="section-head">
                  <div>
                    <h2>Plan de produccion</h2>
                    <p id="plannerSummary"></p>
                  </div>
                  <button class="btn icon-btn" type="button" data-jump="calendario" aria-label="Ver calendario">
                    <span class="icon" data-icon="calendar"></span>
                  </button>
                </div>
                <div class="plan-insights" id="planInsights"></div>
                <div class="stat-line">
                  <div class="plan-actions">
                    <strong>Capacidad usada</strong>
                    <span class="chip" id="planDecisionChip">OK</span>
                  </div>
                  <div class="progress"><span id="capacityBar" style="--value: 0%;"></span></div>
                  <small id="capacityText"></small>
                </div>
              </article>
            </div>
            <div class="dashboard-insights">
              <article class="card dashboard-card insight-action" role="button" tabindex="0" data-jump="lotes" id="dashboardOperationCard"></article>
              <article class="card dashboard-card insight-action" role="button" tabindex="0" data-jump="ventas" id="dashboardBusinessCard"></article>
              <article class="card dashboard-card insight-action" role="button" tabindex="0" data-jump="reportes" id="dashboardSummaryCard"></article>
            </div>
          </section>

          <section class="section" id="lotes" data-title="Lotes" data-subtitle="Gestion independiente por lote, desde ingreso hasta cierre.">
            <div class="grid two">
              <article class="card">
                <div class="card-pad section-head">
                  <div>
                    <h2>Gestion de lotes</h2>
                    <p>Identificador automatico, costos y fechas calculadas.</p>
                  </div>
                </div>
                <div class="table-wrap">
                  <table class="sales-table">
                    <thead>
                      <tr>
                        <th>Codigo</th>
                        <th>Ingreso</th>
                        <th>Salida estimada</th>
                        <th>Ingresadas</th>
                        <th>Vivas</th>
                        <th>Costo acumulado</th>
                        <th>Costo/kg</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                      </tr>
                    </thead>
                    <tbody id="lotsRows"></tbody>
                  </table>
                </div>
              </article>
              <article class="card card-pad">
                <h2>Nuevo lote</h2>
                <form class="form-grid" id="lotForm">
                  <label>Fecha de ingreso <input name="entryDate" type="date" value={today} required /></label>
                  <label>Pollitos ingresados <input name="chicks" type="number" min="1" value="53" required /></label>
                  <label>Costo unitario pollito <input name="chickCost" type="number" min="0" value="2800" required /></label>
                  <label>Proveedor <input name="supplier" value="Proveedor local" /></label>
                  <label>Raza o linea <input name="breed" value="Ross 308" /></label>
                  <label>Galpon o modulo <input name="house" value="Modulo A" /></label>
                  <label>Edad objetivo salida <input name="targetAge" type="number" min="1" value="49" /></label>
                  <label>Peso objetivo kg <input name="targetWeight" type="number" min="0" step=".01" value="2.2" /></label>
                  <label class="span-2">Notas <textarea name="notes" placeholder="Observaciones del lote"></textarea></label>
                  <button class="btn primary span-2" type="submit">Crear lote</button>
                </form>
              </article>
            </div>
          </section>

          <section class="section" id="lote-detalle" data-title="Detalle de lote" data-subtitle="Resumen completo, historiales y rentabilidad del lote seleccionado.">
            <article class="card">
              <div class="card-pad section-head">
                <div>
                  <h2 id="lotDetailTitle">Detalle de lote</h2>
                  <p>Resumen, historiales y rentabilidad por lote.</p>
                </div>
                <div class="component-actions">
                  <button class="btn icon-btn" type="button" id="backToLotsButton" aria-label="Volver a lotes">
                    <span class="icon" data-icon="collapse"></span>
                  </button>
                  <select id="lotDetailSelect" aria-label="Seleccionar lote"></select>
                </div>
              </div>
              <div class="lot-operation-nav" id="lotOperationNav"></div>
              <div class="tabs" id="lotTabs"></div>
              <div id="lotPanels"></div>
            </article>
          </section>

          <section class="section" id="registro-diario" data-title="Registro diario" data-subtitle="Formulario rapido para registrar el dia en menos de un minuto.">
            <div class="grid two">
              <article class="card card-pad">
                <h2>Registrar dia</h2>
                <form class="form-grid" id="dailyForm">
                  <label>Fecha <input name="date" type="date" value={today} required /></label>
                  <label>Lote <select name="lotId" data-lot-options required></select></label>
                  <label>Aves vivas <input name="liveBirds" type="number" min="0" placeholder="Se calcula si lo dejas vacio" /></label>
                  <label>Muertes del dia <input name="deaths" type="number" min="0" value="0" required /></label>
                  <label>Alimento kg <input name="feedKg" type="number" min="0" step=".01" value="0" required /></label>
                  <label>Tipo de alimento <select name="feedType" data-feed-options></select></label>
                  <label>Peso promedio kg <input name="avgWeight" type="number" min="0" step=".01" placeholder="Opcional" /></label>
                  <label>Tratamiento <input name="treatment" placeholder="Medicamentos o vacunas" /></label>
                  <label class="span-2">Observaciones <textarea name="notes"></textarea></label>
                  <button class="btn primary span-2" type="submit">Guardar registro</button>
                </form>
              </article>
              <article class="card">
                <div class="card-pad">
                  <h2>Historial reciente</h2>
                  <p>Registros diarios de alimentacion, mortalidad y peso.</p>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr><th>Fecha</th><th>Lote</th><th>Muertes</th><th>Alimento</th><th>Peso</th><th>Notas</th></tr>
                    </thead>
                    <tbody id="dailyRows"></tbody>
                  </table>
                </div>
              </article>
            </div>
          </section>

          <section class="section" id="alimentacion" data-title="Alimentacion" data-subtitle="Compras, consumo y costo automatico por kilogramo.">
            <div class="grid two">
              <article class="card card-pad">
                <h2>Compra de alimento</h2>
                <form class="form-grid" id="feedPurchaseForm">
                  <label>Producto <select name="type" data-feed-options></select></label>
                  <label>Proveedor <input name="supplier" value="Agroinsumos" /></label>
                  <label>Fecha <input name="date" type="date" value={today} /></label>
                  <label>Numero de sacos <input name="sacks" type="number" min="0" value="2" /></label>
                  <label>Peso por saco kg <input name="kgPerSack" type="number" min="0" step=".01" value="40" /></label>
                  <label>Precio por saco <input name="pricePerSack" type="number" min="0" value="80000" /></label>
                  <button class="btn primary span-2" type="submit">Registrar compra</button>
                </form>
              </article>
              <article class="card">
                <div class="card-pad">
                  <h2>Inventario de alimento</h2>
                  <p>El consumo diario descuenta automaticamente el stock.</p>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Alimento</th><th>Existencia</th><th>Costo/kg</th><th>Stock minimo</th><th>Estado</th></tr></thead>
                    <tbody id="feedRows"></tbody>
                  </table>
                </div>
              </article>
            </div>
          </section>

          <section class="section" id="gastos" data-title="Gastos" data-subtitle="Costos asociados a un lote, varios lotes o toda la granja.">
            <div class="grid two">
              <article class="card card-pad">
                <h2>Registrar gasto</h2>
                <form class="form-grid" id="expenseForm">
                  <label>Fecha <input name="date" type="date" value={today} /></label>
                  <label>Categoria <select name="category" id="expenseCategory"></select></label>
                  <label>Concepto <input name="concept" placeholder="Ej. Cama, vacuna, transporte" required /></label>
                  <label>Valor <input name="amount" type="number" min="0" required /></label>
                  <label>Proveedor <input name="supplier" /></label>
                  <label>Lote <select name="lotId" data-lot-options><option value="farm">Toda la granja</option></select></label>
                  <label class="span-2">Observaciones <textarea name="notes"></textarea></label>
                  <button class="btn primary span-2" type="submit">Guardar gasto</button>
                </form>
              </article>
              <article class="card">
                <div class="card-pad">
                  <h2>Gastos recientes</h2>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Fecha</th><th>Categoria</th><th>Concepto</th><th>Lote</th><th>Valor</th></tr></thead>
                    <tbody id="expenseRows"></tbody>
                  </table>
                </div>
              </article>
            </div>
          </section>

          <section class="section" id="pesajes" data-title="Pesajes" data-subtitle="Peso promedio vs edad, objetivo y ganancia diaria.">
            <div class="grid two">
              <article class="card card-pad">
                <h2>Registrar pesaje</h2>
                <form class="form-grid" id="weightForm">
                  <label>Fecha <input name="date" type="date" value={today} /></label>
                  <label>Lote <select name="lotId" data-lot-options></select></label>
                  <label>Aves muestreadas <input name="sampleBirds" type="number" min="0" value="10" /></label>
                  <label>Peso total kg <input name="totalWeight" type="number" min="0" step=".01" /></label>
                  <label>Peso promedio kg <input name="avgWeight" type="number" min="0" step=".01" required /></label>
                  <button class="btn primary span-2" type="submit">Guardar pesaje</button>
                </form>
              </article>
              <article class="card card-pad">
                <div class="section-head">
                  <div>
                    <h2>Evolucion de peso</h2>
                  </div>
                </div>
                <div id="weightChart" class="grid"></div>
              </article>
            </div>
          </section>

          <section class="section" id="mortalidad" data-title="Mortalidad" data-subtitle="Registro simple y alertas por meta configurable.">
            <div class="grid two">
              <article class="card card-pad">
                <h2>Registrar mortalidad</h2>
                <form class="form-grid" id="mortalityForm">
                  <label>Fecha <input name="date" type="date" value={today} /></label>
                  <label>Lote <select name="lotId" data-lot-options></select></label>
                  <label>Cantidad <input name="quantity" type="number" min="1" value="1" /></label>
                  <label>Causa conocida <input name="cause" placeholder="Opcional" /></label>
                  <label class="span-2">Observacion <textarea name="notes"></textarea></label>
                  <button class="btn primary span-2" type="submit">Guardar mortalidad</button>
                </form>
              </article>
              <article class="card">
                <div class="card-pad"><h2>Comparacion entre lotes</h2></div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Lote</th><th>Muertes</th><th>Mortalidad</th><th>Meta</th><th>Estado</th></tr></thead>
                    <tbody id="mortalityRows"></tbody>
                  </table>
                </div>
              </article>
            </div>
          </section>

          <section class="section" id="procesamiento" data-title="Procesamiento / sacrificio" data-subtitle="Rendimiento de canal, merma y costo final del pollo terminado.">
            <article class="card card-pad processing-summary-panel" id="processingSummaryPanel">
              <div class="section-head">
                <div>
                  <h2>Indicadores finales</h2>
                  <p>Costo final, rendimiento y precios sugeridos para facturacion.</p>
                </div>
              </div>
              <div class="grid three" id="processingSummary"></div>
            </article>
            <article class="card processing-records-card">
              <div class="card-pad section-head">
                <div>
                  <h2>Registros generales</h2>
                  <p>Historial completo de sacrificio, libras facturables y valor potencial.</p>
                </div>
                <div class="component-actions" aria-label="Acciones de registros de procesamiento">
                  <div class="inline-search" id="processingSearchShell">
                    <input id="processingSearch" type="search" placeholder="Buscar registro..." aria-label="Buscar registros de procesamiento" />
                  </div>
                  <button class="btn icon-btn" type="button" id="processingSearchToggle" aria-label="Buscar procesamiento" aria-expanded="false">
                    <span class="icon" data-icon="search"></span>
                  </button>
                  <button class="btn icon-btn" type="button" id="openPriceListButton" aria-label="Ver y configurar tabla de precios">
                    <span class="icon" data-icon="cost"></span>
                  </button>
                  <button class="btn icon-btn" type="button" id="processingSummaryToggle" aria-label="Ver indicadores de procesamiento" aria-expanded="false">
                    <span class="icon" data-icon="reports"></span>
                  </button>
                  <button class="btn icon-btn primary" type="button" id="openProcessingButton" aria-label="Registrar procesamiento">
                    <span class="icon" data-icon="process"></span>
                  </button>
                </div>
              </div>
              <div class="table-wrap">
                <table data-no-smart-table>
                  <thead><tr><th>Fecha</th><th>Lote</th><th>Producto</th><th>Aves</th><th>Libras facturables</th><th>Rendimiento</th><th>Costo/libra</th><th>Facturacion sugerida</th></tr></thead>
                  <tbody id="processingRows"></tbody>
                </table>
              </div>
            </article>
          </section>

          <section class="section" id="ventas" data-title="Ventas" data-subtitle="Distribuidor, venta directa, productos, pagos y rentabilidad.">
            <div class="grid two">
              <article class="card card-pad">
                <h2>Registrar venta</h2>
                <form class="form-grid" id="saleForm">
                  <input name="editIndex" type="hidden" value="" />
                  <label>Fecha <input name="date" type="date" value={today} /></label>
                  <label>Cliente <select name="customerId" id="customerOptions"></select></label>
                  <label>Canal <select name="channel"><option>Distribuidor</option><option>Venta directa</option><option>Restaurante</option></select></label>
                  <label>Lote <select name="lotId" data-lot-options></select></label>
                  <label>Producto <select name="product" id="productOptions"></select></label>
                  <label>Cantidad <input name="quantity" type="number" min="1" value="10" /></label>
                  <label>Gramos facturados <input name="grams" type="number" min="0" step="1" value="10000" /></label>
                  <label>Precio/gramo <input name="priceGram" type="number" min="0" step=".01" value="23.37" readonly /></label>
                  <label>Forma de pago <select name="paymentMethod"><option>Transferencia</option><option>Efectivo</option><option>Credito</option></select></label>
                  <label>Estado pago <select name="paymentStatus"><option>Pagado</option><option>Pendiente</option><option>Parcial</option><option>Cancelada</option></select></label>
                  <button class="btn primary span-2" type="submit">Generar factura</button>
                </form>
              </article>
              <article class="card">
                <div class="card-pad section-head">
                  <div>
                    <h2>Ventas recientes</h2>
                    <p>Facturas por cliente, producto, gramos y estado de pago.</p>
                  </div>
                  <div class="component-actions" aria-label="Acciones de ventas">
                    <button class="btn icon-btn" type="button" id="openPriceCalculatorButton" aria-label="Abrir calculadora de precio">
                      <span class="icon" data-icon="cost"></span>
                    </button>
                  </div>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Factura</th><th>Fecha</th><th>Cliente</th><th>Canal</th><th>Producto</th><th>Gramos</th><th>Precio/gramo</th><th>Total</th><th>Pago</th><th>Acciones</th></tr></thead>
                    <tbody id="salesRows"></tbody>
                    <tfoot><tr><td colspan="7">Total ventas</td><td id="salesTotal"></td><td colspan="2"></td></tr></tfoot>
                  </table>
                </div>
              </article>
            </div>
          </section>

          <section class="section" id="clientes" data-title="Clientes" data-subtitle="Compras acumuladas, ultima compra y saldos pendientes.">
            <div class="grid two">
              <article class="card card-pad">
                <h2>Nuevo cliente</h2>
                <form class="form-grid" id="customerForm">
                  <label>Nombre <input name="name" required /></label>
                  <label>Tipo <select name="type"><option>Consumidor final</option><option>Distribuidor</option><option>Restaurante</option><option>Tienda</option><option>Otro</option></select></label>
                  <label>Telefono <input name="phone" /></label>
                  <label>WhatsApp <input name="whatsapp" /></label>
                  <label>Ciudad <input name="city" value="Medellin" /></label>
                  <label>Canal <input name="channel" value="Venta directa" /></label>
                  <label class="span-2">Observaciones <textarea name="notes"></textarea></label>
                  <button class="btn primary span-2" type="submit">Guardar cliente</button>
                </form>
              </article>
              <article class="card">
                <div class="card-pad"><h2>Clientes</h2></div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Nombre</th><th>Tipo</th><th>Canal</th><th>Compras</th><th>Ultima compra</th><th>Saldo</th></tr></thead>
                    <tbody id="customersRows"></tbody>
                  </table>
                </div>
              </article>
            </div>
          </section>

          <section class="section" id="inventario" data-title="Inventario" data-subtitle="Alimentos, medicamentos, empaques y producto terminado.">
            <article class="card">
              <div class="card-pad section-head">
                <div>
                  <h2>Inventario general</h2>
                  <p>Existencias, costos, ultima compra y stock minimo.</p>
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead><tr><th>Categoria</th><th>Item</th><th>Existencia</th><th>Unidad</th><th>Costo</th><th>Ultima compra</th><th>Minimo</th><th>Estado</th></tr></thead>
                  <tbody id="inventoryRows"></tbody>
                </table>
              </div>
            </article>
          </section>

          <section class="section" id="usuarios" data-title="Usuarios" data-subtitle="Equipo interno, roles y permisos de operacion.">
            <div class="grid two">
              <article class="card card-pad">
                <h2>Nuevo usuario</h2>
                <form class="form-grid" id="userForm">
                  <label>Nombre <input name="name" required /></label>
                  <label>Correo <input name="email" type="email" required /></label>
                  <label>Telefono <input name="phone" /></label>
                  <label>Rol <select name="role"><option>Operativo</option><option>Administrativo</option></select></label>
                  <label>Area <select name="area"><option>Galpones</option><option>Procesamiento</option><option>Ventas</option><option>Inventario</option><option>Direccion</option><option>Administracion</option></select></label>
                  <label>Estado <select name="status"><option>Activo</option><option>Inactivo</option><option>Invitado</option></select></label>
                  <label class="span-2">Permisos <textarea name="permissions" placeholder="Ej. Registro diario, alimentacion y pesajes"></textarea></label>
                  <button class="btn primary span-2" type="submit">Guardar usuario</button>
                </form>
              </article>
              <article class="card">
                <div class="card-pad">
                  <h2>Equipo interno</h2>
                  <p>Usuarios administrativos y operativos con acceso por responsabilidad.</p>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Usuario</th><th>Rol</th><th>Area</th><th>Correo</th><th>Telefono</th><th>Permisos</th><th>Estado</th></tr></thead>
                    <tbody id="usersRows"></tbody>
                  </table>
                </div>
              </article>
            </div>
          </section>

          <section class="section" id="calendario" data-title="Calendario de produccion" data-subtitle="Planificador diario, semanal y mensual de operacion.">
            <div class="calendar-shell">
              <article class="card card-pad calendar-panel">
                <div class="section-head">
                  <div>
                    <h2 id="calendarViewTitle">Planificador</h2>
                    <p id="calendarViewSubtitle">Tareas por fecha para entradas, alimento, pesajes, procesamiento y ventas.</p>
                  </div>
                  <div class="calendar-toolbar" aria-label="Acciones de calendario">
                    <div class="view-switch" id="calendarViewSwitch" aria-label="Cambiar vista de calendario">
                      <button type="button" data-calendar-view="day">Dia</button>
                      <button type="button" data-calendar-view="week">Semana</button>
                      <button type="button" data-calendar-view="month" class="is-active">Mes</button>
                    </div>
                    <button class="btn icon-btn" type="button" id="openCalendarChartsButton" aria-label="Ver graficas del calendario">
                      <span class="icon" data-icon="reports"></span>
                    </button>
                    <button class="btn icon-btn" type="button" id="openCalendarIndicatorsButton" aria-label="Ver indicadores del plan">
                      <span class="icon" data-icon="alert"></span>
                    </button>
                    <button class="btn icon-btn" type="button" data-info-topic="calendario" aria-label="Informacion del plan mensual">
                      <span class="icon" data-icon="info"></span>
                    </button>
                    <button class="btn icon-btn" type="button" id="openPlannerButton" aria-label="Planificador automatico">
                      <span class="icon" data-icon="calendar"></span>
                    </button>
                    <button class="btn icon-btn primary" type="button" id="openTaskButton" aria-label="Agregar tarea">
                      <span class="icon" data-icon="add"></span>
                    </button>
                  </div>
                </div>
                <div class="calendar-grid month" id="calendarGrid"></div>
              </article>
            </div>
          </section>

          <section class="section" id="reportes" data-title="Reportes" data-subtitle="Produccion, costos, ventas, rentabilidad y comparacion entre lotes.">
            <div class="grid three">
              <article class="card card-pad">
                <h2>Reporte financiero</h2>
                <p id="financialReport"></p>
                <button class="btn" type="button" id="exportCsv">Exportar CSV</button>
              </article>
              <article class="card card-pad">
                <h2>Resumen productivo</h2>
                <p id="productionReport"></p>
              </article>
              <article class="card card-pad">
                <h2>Rentabilidad</h2>
                <p id="profitReport"></p>
              </article>
            </div>
            <article class="card" style="margin-top: 1rem;">
              <div class="card-pad"><h2>Comparacion entre lotes</h2></div>
              <div class="table-wrap">
                <table>
                  <thead><tr><th>Indicador</th><th>L001</th><th>L002</th><th>L003</th><th>L004</th></tr></thead>
                  <tbody id="comparisonRows"></tbody>
                </table>
              </div>
            </article>
            <article class="card card-pad" style="margin-top: 1rem;">
              <div class="section-head">
                <div>
                  <h2>Referencia operativa</h2>
                  <p>Tabla renderizada con el componente DataTable de Webcore UI.</p>
                </div>
              </div>
              <DataTable
                id="webcore-benchmark-table"
                className="webcore-reference"
                headings={benchmarkHeadings}
                data={benchmarkRows}
                filterPlaceholder="Filtrar indicadores"
                showFilterIcon
                itemsPerPage={3}
                hover
                striped="row"
                compact
                subText="Metas configurables para produccion de pollo de engorde"
              />
            </article>
          </section>

          <section class="section" id="configuracion" data-title="Configuracion" data-subtitle="Parametros modificables para adaptar el sistema a la granja.">
            <article class="card card-pad">
              <h2>Parametros de operacion</h2>
              <form class="form-grid" id="settingsForm">
                <label>Meta conversion excelente <input name="excellentFcr" type="number" min="0" step=".01" /></label>
                <label>Meta conversion aceptable <input name="acceptableFcr" type="number" min="0" step=".01" /></label>
                <label>Alerta mortalidad % <input name="mortalityAlert" type="number" min="0" step=".01" /></label>
                <label>Margen distribuidor % <input name="distMargin" type="number" min="0" max="95" /></label>
                <label>Margen venta directa % <input name="directMargin" type="number" min="0" max="95" /></label>
                <label>Formato moneda <input value="COP" disabled /></label>
                <button class="btn primary span-2" type="submit">Guardar configuracion</button>
              </form>
            </article>
            <article class="card card-pad" style="margin-top: 1rem;">
              <div class="section-head">
                <div>
                  <h2>Fundamentos del sistema</h2>
                  <p>Tokens semanticos usados por componentes, tablas, formularios y estados.</p>
                </div>
              </div>
              <div class="design-system-grid">
                <div class="token-swatch" style="--swatch: var(--brand);"><strong>Brand</strong><span>Acciones principales y navegacion activa</span></div>
                <div class="token-swatch" style="--swatch: var(--surface);"><strong>Surface</strong><span>Tarjetas, formularios y paneles</span></div>
                <div class="token-swatch" style="--swatch: var(--warning);"><strong>Warning</strong><span>Alertas productivas y capacidad</span></div>
                <div class="token-swatch" style="--swatch: var(--danger);"><strong>Danger</strong><span>Mortalidad alta y pagos pendientes</span></div>
              </div>
            </article>
          </section>
        </div>
      </main>
    </div>

