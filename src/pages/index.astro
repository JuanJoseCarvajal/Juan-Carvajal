      function ensureTitleToolbar(header) {
        header.classList.add('section-head');
        let actions = header.querySelector(':scope > .component-actions');
        if (!actions) {
          actions = document.createElement('div');
          actions.className = 'component-actions';
          header.appendChild(actions);
        }
        if (!header.firstElementChild?.matches('div:not(.component-actions):not(.smart-table-toolbar)')) {
          const title = document.createElement('div');
          title.className = 'component-title';
          Array.from(header.childNodes)
            .filter((node) => node !== actions)
            .forEach((node) => title.appendChild(node));
          header.insertBefore(title, actions);
        }
        return actions;
      }

      function createFormOverlay({ formId, title, description, iconName, targetHeader }) {
        const form = document.querySelector(`#${formId}`);
        const sourceCard = form?.closest('article.card');
        const header = document.querySelector(targetHeader);
        if (!form || !sourceCard || !header) return;

        sourceCard.parentElement?.classList.add('single-content-grid');
        const modal = document.createElement('div');
        modal.className = 'quick-modal record-form-modal';
        modal.id = `${formId}Modal`;
        modal.setAttribute('role', 'dialog');
        modal.setAttribute('aria-modal', 'true');
        modal.setAttribute('aria-labelledby', `${formId}ModalTitle`);
        modal.innerHTML = `
          <div class="quick-dialog">
            <div class="quick-dialog-head">
              <div>
                <h2 id="${formId}ModalTitle">${title}</h2>
                <p>${description}</p>
              </div>
              <button class="btn icon-btn" type="button" data-close-form-modal="${formId}" aria-label="Cerrar"><span class="icon" data-icon="close"></span></button>
            </div>
            <div class="quick-body" style="grid-template-columns: 1fr;"></div>
          </div>
        `;
        modal.querySelector('.quick-body').appendChild(sourceCard);
        document.body.appendChild(modal);

        const actions = ensureTitleToolbar(header);
        const openButton = document.createElement('button');
        openButton.className = 'btn icon-btn primary';
        openButton.type = 'button';
        openButton.setAttribute('aria-label', title);
        openButton.innerHTML = `<span class="icon" data-icon="${iconName}"></span>`;
        actions.appendChild(openButton);

        const close = () => modal.classList.remove('is-open');
        openButton.addEventListener('click', () => modal.classList.add('is-open'));
        form.addEventListener('submit', () => window.setTimeout(close, 0));
        modal.addEventListener('click', (event) => {
          if (event.target === modal || event.target.closest(`[data-close-form-modal="${formId}"]`)) close();
        });
      }

