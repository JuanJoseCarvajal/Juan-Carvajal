      function renderInventory() {
        const feedRows = state.feedInventory.map((feed) => ({ category: 'Alimentos', item: feed.type, qty: feed.kg, unit: 'kg', cost: feed.costPerKg, lastPurchase: feed.lastPurchase, min: feed.min }));
        document.querySelector('#inventoryRows').innerHTML = [...feedRows, ...state.inventory].map((item) => `<tr><td>${item.category}</td><td>${item.item}</td><td>${number(item.qty, 1)}</td><td>${item.unit}</td><td>${money(item.cost)}</td><td>${dateLabel(item.lastPurchase)}</td><td>${number(item.min, 1)}</td><td>${item.qty <= item.min ? '<span class="chip warning">Bajo</span>' : '<span class="chip">OK</span>'}</td></tr>`).join('');
      }

      function renderCalendar() {
        const chicks = recommendedChicks();
        const simultaneousLots = Math.ceil(Number(state.planner.cycleDays || 0) / Number(state.planner.intervalDays || 1));
        const capacity = chicks * simultaneousLots;
        const activeLots = getMetrics().activeLots;
        const availableCapacity = Number(state.planner.capacity) - activeLots.reduce((sum, lot) => sum + lotLiveBirds(lot), 0);
        const tasks = calendarTasks().toSorted((a, b) => a.date.localeCompare(b.date));
        document.querySelector('#calendarRiskList').innerHTML = [
          chartRow('Uso actual', `${state.planner.capacity - availableCapacity} de ${state.planner.capacity} aves`, Math.min(100, (state.planner.capacity - availableCapacity) / state.planner.capacity * 100)),
          chartRow('Capacidad requerida', `${capacity} aves`, Math.min(100, capacity / state.planner.capacity * 100)),
          chartRow('Tareas de alta prioridad', `${tasks.filter((task) => task.priority === 'Alta').length} tareas`, Math.min(100, tasks.filter((task) => task.priority === 'Alta').length * 25))
        ].join('');
        renderCalendarGrid(tasks);
        const base = state.lots[0]?.entryDate || new Date().toISOString().slice(0, 10);
        const planned = Array.from({ length: 4 }, (_, index) => {
          const entry = addDays(base, index * state.planner.intervalDays);
          return { id: `L${String(index + 1).padStart(2, '0')}`, entry, exit: addDays(entry, state.planner.cycleDays) };
        });
        document.querySelector('#timeline').innerHTML = planned.map((lot) => `<div class="timeline-item"><strong>${lot.id} | Entrada ${dateLabel(lot.entry)} | Salida ${dateLabel(lot.exit)}</strong><div class="bar" title="Inicio, crecimiento, engorde, procesamiento y venta"><span></span><span></span><span></span><span></span><span></span></div><div class="bar-labels"><span>Inicio</span><span>Crecimiento</span><span>Engorde</span><span>Proceso</span><span>Venta</span></div></div>`).join('');
      }

      function calendarTasks() {
        const generated = state.lots.flatMap((lot) => {
          const exit = addDays(lot.entryDate, lot.targetAge || state.planner.cycleDays);
          const weighDate = addDays(lot.entryDate, Math.max(7, Math.floor(Number(lot.targetAge || 49) * .55)));
          return [
            { id: `${lot.id}-entry`, date: lot.entryDate, recurrence: 'none', allDay: true, assigneeId: 'U002', status: 'Pendiente', type: 'Operacion', lotId: lot.id, priority: 'Media', title: `Ingreso ${lot.id}`, notes: `${lot.chicks} pollitos | ${lot.house}` },
            { id: `${lot.id}-weight`, date: weighDate, recurrence: 'none', allDay: false, startTime: '08:00', endTime: '09:00', assigneeId: 'U002', status: 'Pendiente', type: 'Pesaje', lotId: lot.id, priority: 'Media', title: `Pesaje de control ${lot.id}`, notes: `Validar avance hacia ${number(lot.targetWeight, 2)} kg.` },
            { id: `${lot.id}-prep`, date: addDays(exit, -2), recurrence: 'none', allDay: false, startTime: '10:00', endTime: '11:00', assigneeId: 'U001', status: 'Pendiente', type: 'Procesamiento', lotId: lot.id, priority: 'Alta', title: `Preparar salida ${lot.id}`, notes: 'Confirmar pedidos, empaque y capacidad de sacrificio.' },
            { id: `${lot.id}-sale`, date: exit, recurrence: 'none', allDay: true, assigneeId: 'U001', status: 'Pendiente', type: 'Venta', lotId: lot.id, priority: 'Alta', title: `Procesar y facturar ${lot.id}`, notes: 'Registrar libras facturables y ventas.' }
          ];
        });
        return expandCalendarTasks([...generated, ...(state.tasks || [])]);
      }

      function renderCalendarGrid(tasks) {
        const grid = document.querySelector('#calendarGrid');
        const todayDate = new Date(new Date().toDateString());
        const dates = calendarDatesForView(calendarView, todayDate);
        grid.className = `calendar-grid ${calendarView}`;
        document.querySelector('#calendarViewTitle').textContent = calendarView === 'day' ? 'Plan diario' : calendarView === 'week' ? 'Plan semanal' : 'Plan mensual';
        document.querySelector('#calendarViewSubtitle').textContent = calendarView === 'day'
          ? 'Agenda operativa de hoy.'
          : calendarView === 'week'
            ? 'Acciones de los proximos 7 dias.'
            : 'Vista mensual tipo planificador para anticipar capacidad, salidas y ventas.';
        grid.innerHTML = dates.map((date) => {
          const iso = date.toISOString().slice(0, 10);
          const dayTasks = tasks.filter((task) => task.date === iso);
          const isToday = iso === todayDate.toISOString().slice(0, 10);
          const isMuted = calendarView === 'month' && date.getMonth() !== todayDate.getMonth();
          return `
            <div class="calendar-day ${isToday ? 'is-today' : ''} ${isMuted ? 'is-muted' : ''}">
              <div class="calendar-day-head"><span>${date.toLocaleDateString('es-CO', { weekday: 'short' })}</span><strong>${date.getDate()}</strong></div>
              <div class="calendar-task-list">
                ${dayTasks.slice(0, calendarView === 'month' ? 4 : 8).map((task) => calendarTaskCard(task)).join('') || '<span class="calendar-task"><strong>Sin tareas</strong><span>Disponible para planear</span></span>'}
              </div>
            </div>
          `;
        }).join('');
        document.querySelectorAll('[data-calendar-view]').forEach((button) => button.classList.toggle('is-active', button.dataset.calendarView === calendarView));
      }

      function calendarTaskCard(task) {
        const lotText = task.lotId && task.lotId !== 'farm' ? ` | ${task.lotId}` : '';
        const repeatText = task.isRecurring ? ` | ${recurrenceLabel(task)}` : '';
        const tooltip = [
          task.title,
          `${dateLabel(task.date)} | ${taskTime(task)}`,
          `Encargado: ${userName(task.assigneeId)}`,
          `Estado: ${task.status} | Prioridad: ${task.priority}`,
          `${task.type}${lotText}${repeatText}`,
          task.notes
        ].filter(Boolean).join('\n');
        return `<div class="calendar-task ${task.priority === 'Alta' ? 'danger' : task.priority === 'Media' ? 'warning' : ''}" data-tooltip="${escapeAttr(tooltip)}" title="${escapeAttr(tooltip)}" tabindex="0"><strong>${escapeHtml(task.title)}</strong><span>${escapeHtml(taskTime(task))} | ${escapeHtml(userName(task.assigneeId))}</span><span>${escapeHtml(`${task.type}${lotText}${repeatText}`)}</span></div>`;
      }

      function calendarDatesForView(view, baseDate) {
        if (view === 'day') return [baseDate];
        const start = new Date(baseDate);
        start.setDate(baseDate.getDate() - ((baseDate.getDay() + 6) % 7));
        const length = view === 'week' ? 7 : 42;
        if (view === 'month') {
          start.setDate(1);
          start.setDate(start.getDate() - ((start.getDay() + 6) % 7));
        }
        return Array.from({ length }, (_, index) => {
          const date = new Date(start);
          date.setDate(start.getDate() + index);
          return date;
        });
      }

