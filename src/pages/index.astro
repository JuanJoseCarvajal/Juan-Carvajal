      function priceRow(product, index) {
        const isEditing = priceEditingIndex === index;
        const unitLabel = product.unit === 'libra' ? 'Precio base por libra' : `Precio configurado por ${product.unit}`;
        const kgEquivalent = product.unit === 'libra' ? money(product.priceLb * 2.20462) : '-';
        if (isEditing) {
          return `
            <tr data-price-row="${index}">
              <td><input class="table-input" name="name" value="${product.name}" aria-label="Nombre del producto" /></td>
              <td>
                <select class="table-input" name="unit" aria-label="Unidad del producto">
                  ${['libra', 'kg', 'unidad'].map((unit) => `<option ${unit === product.unit ? 'selected' : ''}>${unit}</option>`).join('')}
                </select>
              </td>
              <td><input class="table-input is-number" name="priceLb" type="number" min="0" value="${product.priceLb}" aria-label="Precio por libra" /></td>
              <td>${kgEquivalent}</td>
              <td>${unitLabel}</td>
              <td>
                <div class="row-actions">
                  <button class="btn icon-btn primary" type="button" data-price-action="save" data-price-index="${index}" aria-label="Guardar producto"><span class="icon">${icon('save')}</span></button>
                  <button class="btn icon-btn" type="button" data-price-action="cancel" aria-label="Cancelar edicion"><span class="icon">${icon('close')}</span></button>
                </div>
              </td>
            </tr>
          `;
        }
        return `
          <tr data-price-row="${index}">
            <td>${product.name}</td>
            <td>${product.unit}</td>
            <td>${money(product.priceLb)}</td>
            <td>${kgEquivalent}</td>
            <td>${unitLabel}</td>
            <td>
              <div class="row-actions">
                <button class="btn icon-btn" type="button" data-price-action="edit" data-price-index="${index}" aria-label="Editar ${product.name}"><span class="icon">${icon('edit')}</span></button>
              </div>
            </td>
          </tr>
        `;
      }

