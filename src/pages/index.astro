        const nextOpen = !shell.classList.contains('is-open');
        shell.classList.toggle('is-open', nextOpen);
        document.querySelector('#activeLotsSearchToggle')?.setAttribute('aria-expanded', nextOpen ? 'true' : 'false');
        if (nextOpen) {
          input.focus();
        } else {
          input.value = '';
          activeLotsQuery = '';
          renderDashboard();
        }
      });
      document.querySelector('#activeLotsSearch')?.addEventListener('input', (event) => {
        activeLotsQuery = event.target.value.toLowerCase().trim();
        renderDashboard();
      });
      document.querySelector('#processingSearchToggle').addEventListener('click', () => {
        const shell = document.querySelector('#processingSearchShell');
        const input = document.querySelector('#processingSearch');
        const nextOpen = !shell.classList.contains('is-open');
        shell.classList.toggle('is-open', nextOpen);
        document.querySelector('#processingSearchToggle').setAttribute('aria-expanded', nextOpen ? 'true' : 'false');
        if (nextOpen) {
          input.focus();
        } else {
          input.value = '';
          processingQuery = '';
          renderProcessing();
        }
      });
      document.querySelector('#processingSearch').addEventListener('input', (event) => {
        processingQuery = event.target.value.toLowerCase().trim();
        renderProcessing();
      });
      document.querySelector('#themeToggle').addEventListener('click', () => {
        applyTheme(document.body.dataset.theme === 'dark' ? 'light' : 'dark');
      });
      document.querySelector('#seedButton').addEventListener('click', () => {
        state = structuredClone(demoState);
        saveState();
        renderAll();
      });
      document.querySelector('#lotDetailSelect').addEventListener('change', (event) => {
        activeLotId = event.target.value;
        renderLotDetail(event.target.value);
      });
      document.querySelector('#saleForm').elements.product.addEventListener('change', updateSalePriceFromCatalog);
      document.querySelector('#saleForm').elements.channel.addEventListener('change', updateSalePriceFromCatalog);
      document.querySelector('#quickForm').addEventListener('change', (event) => {
        if (event.target.name === 'product') updateQuickSalePriceFromCatalog();
      });
      document.querySelector('#processingForm').elements.carcassKg.addEventListener('input', syncProcessingBillableKg);
      document.querySelector('#processingForm').elements.billableLb.addEventListener('input', (event) => {
        event.target.dataset.touched = 'true';
      });

      document.querySelector('#lotForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        state.lots.push({ id: nextLotId(), ...data, chicks: Number(data.chicks), chickCost: Number(data.chickCost), targetAge: Number(data.targetAge), targetWeight: Number(data.targetWeight) });
        saveState();
        renderAll();
        event.currentTarget.reset();
      });

      document.querySelector('#dailyForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        state.daily.push({ ...data, deaths: Number(data.deaths), feedKg: Number(data.feedKg), avgWeight: Number(data.avgWeight || 0) });
        const feed = state.feedInventory.find((item) => item.type === data.feedType);
        if (feed) feed.kg = Math.max(0, Number(feed.kg) - Number(data.feedKg || 0));
        saveState();
        renderAll();
      });

      document.querySelector('#feedPurchaseForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        const kg = Number(data.sacks) * Number(data.kgPerSack);
        const total = Number(data.sacks) * Number(data.pricePerSack);
        const feed = state.feedInventory.find((item) => item.type === data.type) || { type: data.type, kg: 0, costPerKg: 0, min: 20, lastPurchase: data.date };
        feed.kg = Number(feed.kg) + kg;
        feed.costPerKg = kg ? total / kg : feed.costPerKg;
        feed.lastPurchase = data.date;
        if (!state.feedInventory.includes(feed)) state.feedInventory.push(feed);
        saveState();
        renderAll();
      });

      document.querySelector('#expenseForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        state.expenses.push({ ...data, amount: Number(data.amount) });
        saveState();
        renderAll();
        event.currentTarget.reset();
      });

      document.querySelector('#weightForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        state.weights.push({ ...data, sampleBirds: Number(data.sampleBirds), totalWeight: Number(data.totalWeight || 0), avgWeight: Number(data.avgWeight) });
        saveState();
        renderAll();
      });

      document.querySelector('#mortalityForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        state.mortality.push({ ...data, quantity: Number(data.quantity) });
        saveState();
        renderAll();
      });

      document.querySelector('#processingForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        const processing = {
          ...data,
          birds: Number(data.birds),
          liveKg: Number(data.liveKg),
          carcassKg: Number(data.carcassKg),
          billableLb: Number(data.billableLb || kgToLb(data.carcassKg)),
          slaughterCost: Number(data.slaughterCost),
          packingCost: Number(data.packingCost),
          transportCost: Number(data.transportCost)
        };
        state.processing.push(processing);
        const finished = state.inventory.find((item) => item.category === 'Productos terminados' && item.item === processing.product);
        if (finished) {
          finished.qty = Number(finished.qty || 0) + processing.billableLb;
          finished.cost = processingUnitCost(processing);
          finished.lastPurchase = processing.date;
        } else {
          state.inventory.push({ category: 'Productos terminados', item: processing.product, qty: processing.billableLb, unit: 'libra', cost: processingUnitCost(processing), lastPurchase: processing.date, min: 20 });
        }
        saveState();
        renderAll();
        closeProcessingModal();
        event.currentTarget.reset();
      });

      document.querySelector('#saleForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const data = formData(form);
        const editIndex = data.editIndex === '' ? null : Number(data.editIndex);
        const sale = {
          invoiceId: editIndex === null ? nextInvoiceId() : saleInvoiceId(state.sales[editIndex], editIndex),
          date: data.date,
          customerId: data.customerId,
          channel: data.channel,
          lotId: data.lotId,
          product: data.product,
          quantity: Number(data.quantity),
          grams: Number(data.grams),
          priceGram: Number(data.priceGram),
          paymentMethod: data.paymentMethod,
          paymentStatus: data.paymentStatus
        };
        if (editIndex === null) state.sales.push(sale);
        else state.sales[editIndex] = sale;
        saveState();
        renderAll();
        form.reset();
        form.elements.editIndex.value = '';
        updateSalePriceFromCatalog();
      });

      document.querySelector('#customerForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        state.customers.push({ id: `C${String(state.customers.length + 1).padStart(3, '0')}`, ...data });
        saveState();
        renderAll();
        event.currentTarget.reset();
      });

      document.querySelector('#userForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        state.users = [...(state.users || []), { id: `U${String((state.users || []).length + 1).padStart(3, '0')}`, ...data }];
        saveState();
        renderAll();
        event.currentTarget.reset();
      });

      document.querySelector('#priceForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        renderPriceCalculator({ costGram: Number(data.costGram), grams: Number(data.grams), distMargin: Number(data.distMargin), directMargin: Number(data.directMargin) });
      });

      document.querySelector('#plannerForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        pendingPlanner = Object.fromEntries(Object.entries(data).map(([key, value]) => [key, Number(value)]));
        document.querySelector('#plannerImpactText').textContent = plannerImpactText(pendingPlanner);
        document.querySelector('#plannerImpact').classList.add('is-active');
      });

      document.querySelector('#taskForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const data = formData(form);
        const allDay = form.elements.allDay.checked;
        const task = normalizeTask({
          ...data,
          id: `T${Date.now()}`,
          recurrence: data.recurrence || 'none',
          recurrenceEnd: data.recurrence === 'none' ? '' : form.elements.recurrenceEnd.value,
          allDay,
          startTime: allDay ? '' : form.elements.startTime.value,
          endTime: allDay ? '' : form.elements.endTime.value,
          assigneeId: data.assigneeId || state.users?.[0]?.id || '',
          status: data.status || 'Pendiente'
        }, state.tasks?.length || 0);
        state.tasks = [...(state.tasks || []), task];
        saveState();
        renderAll();
        closeTaskModal();
      });

      document.querySelector('#settingsForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        state.settings = Object.fromEntries(Object.entries(data).map(([key, value]) => [key, Number(value)]));
        saveState();
        renderAll();
      });

      document.querySelector('#quickForm').addEventListener('submit', (event) => {
        event.preventDefault();
        const data = formData(event.currentTarget);
        if (data.section === 'daily') {
          state.daily.push({ ...data, deaths: Number(data.deaths), feedKg: Number(data.feedKg), avgWeight: Number(data.avgWeight || 0), treatment: '' });
          const feed = state.feedInventory.find((item) => item.type === data.feedType);
          if (feed) feed.kg = Math.max(0, Number(feed.kg) - Number(data.feedKg || 0));
        }
        if (data.section === 'feed') {
          recordFeedConsumption(data, 'Alimentacion registrada desde overlay');
        }
        if (data.section === 'mortality') {
          state.mortality.push({ ...data, quantity: Number(data.quantity) });
        }
        if (data.section === 'weight') {
          state.weights.push({ ...data, sampleBirds: Number(data.sampleBirds), totalWeight: Number(data.avgWeight) * Number(data.sampleBirds || 0), avgWeight: Number(data.avgWeight) });
        }
        if (data.section === 'expense') {
          state.expenses.push({ ...data, amount: Number(data.amount), supplier: '', notes: '' });
        }
        if (data.section === 'sale') {
          state.sales.push({ ...data, invoiceId: nextInvoiceId(), product: data.product || currentProductCatalog()[0].name, quantity: 1, grams: Number(data.grams), priceGram: Number(data.priceGram), paymentMethod: 'Efectivo', paymentStatus: 'Pagado' });
        }
        saveState();
        renderAll();
        closeQuickModal();
      });

      document.querySelector('#exportCsv').addEventListener('click', () => {
        const rows = [['Lote', 'Aves vivas', 'Mortalidad %', 'Alimento kg', 'Costo', 'Ventas', 'Utilidad']];
        state.lots.forEach((lot) => rows.push([lot.id, lotLiveBirds(lot), (lotDeaths(lot.id) / lot.chicks * 100).toFixed(2), lotFeedKg(lot.id).toFixed(2), lotCost(lot).toFixed(0), lotSalesTotal(lot.id).toFixed(0), (lotSalesTotal(lot.id) - lotCost(lot)).toFixed(0)]));
        const blob = new Blob([rows.map((row) => row.join(',')).join('\n')], { type: 'text/csv' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'reporte-granja-pro.csv';
        link.click();
        URL.revokeObjectURL(link.href);
      });

      renderAll();
    </script>
  </body>
</html>
